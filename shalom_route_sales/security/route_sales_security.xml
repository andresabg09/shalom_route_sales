<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_route_sales" model="ir.module.category">
        <field name="name">Route Sales</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_route_sales_user" model="res.groups">
        <field name="name">Salesperson</field>
        <field name="category_id" ref="module_category_route_sales"/>
    </record>

    <record id="group_route_sales_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_route_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_route_sales_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
