<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shalom_route_route_list" model="ir.ui.view">
        <field name="name">shalom.route.route.list</field>
        <field name="model">shalom.route.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="vehicle_name"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_shalom_route_route_form" model="ir.ui.view">
        <field name="name">shalom.route.route.form</field>
        <field name="model">shalom.route.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="salesperson_id"/>
                        </group>
                        <group>
                            <field name="vehicle_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customers" name="customers">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="weekday"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_route_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shalom.route.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
