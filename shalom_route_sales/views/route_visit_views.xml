<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shalom_route_visit_list" model="ir.ui.view">
        <field name="name">shalom.route.visit.list</field>
        <field name="model">shalom.route.visit</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='cancelled'" decoration-success="state=='done'">
                <field name="name"/>
                <field name="date"/>
                <field name="route_id"/>
                <field name="salesperson_id"/>
                <field name="stop_count"/>
                <field name="sold_count"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_shalom_route_visit_form" model="ir.ui.view">
        <field name="name">shalom.route.visit.form</field>
        <field name="model">shalom.route.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_stops" type="object" string="Generate Stops"
                            class="btn-secondary" invisible="stop_ids"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="route_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="stop_count"/>
                        <field name="sold_count"/>
                        <field name="amount_total"/>
                    </group>
                    <field name="stop_ids">
                        <list editable="bottom" decoration-success="state=='sold'" decoration-muted="state=='no_sale'">
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="note"/>
                            <field name="state" widget="badge"/>
                            <field name="sale_order_id"/>
                            <field name="amount_total"/>
                            <button name="action_create_sale_order" type="object" string="Create Order"
                                    icon="fa-shopping-cart" invisible="sale_order_id"/>
                            <button name="action_mark_no_sale" type="object" string="No Sale"
                                    icon="fa-ban" invisible="state != 'pending'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shalom_route_visit_calendar" model="ir.ui.view">
        <field name="name">shalom.route.visit.calendar</field>
        <field name="model">shalom.route.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="date" string="Route Visits" color="route_id">
                <field name="route_id"/>
                <field name="salesperson_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_route_visit" model="ir.actions.act_window">
        <field name="name">Route Visits</field>
        <field name="res_model">shalom.route.visit</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>
