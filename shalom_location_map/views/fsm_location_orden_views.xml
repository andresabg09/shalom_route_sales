<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Agrega el campo x_orden_ruta (Orden de Ruta) a las vistas de
        lista y formulario de fsm.location, para que sea editable
        directamente sin tener que ir a las notas de texto.
    -->
    <record id="fsm_location_list_shalom_orden" model="ir.ui.view">
        <field name="name">fsm.location.list.shalom.orden</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_list_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="x_orden_ruta" />
            </xpath>
        </field>
    </record>

    <record id="fsm_location_form_shalom_orden" model="ir.ui.view">
        <field name="name">fsm.location.form.shalom.orden</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="x_orden_ruta" />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    type="object"
                    name="action_abrir_maps"
                    class="oe_stat_button"
                    icon="fa-map-marker"
                    string="Ir con Waze"
                />
            </xpath>
            <!--
                Borra ÚNICAMENTE esta Ubicación (fsm.location), nunca el
                contacto: ver action_eliminar_ubicacion() en
                models/fsm_location.py para el porqué (active delegado al
                contacto vía _inherits). Solo para managers, con
                confirmación obligatoria antes de ejecutar.
            -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="after">
                <div name="shalom_eliminar_ubicacion_box" class="mb-2">
                    <button
                        type="object"
                        name="action_eliminar_ubicacion"
                        string="Eliminar esta Ubicación"
                        class="btn-danger"
                        groups="fieldservice.group_fsm_manager"
                        confirm="Esto borra PERMANENTEMENTE esta Ubicación (fsm.location). El contacto/cliente NO se toca. ¿Confirmás?"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
