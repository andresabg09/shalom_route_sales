<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.Clientes">
        <div class="shalom-screen clientes-screen">
            <div class="topbar">
                <div class="route-name">Clientes</div>
                <div class="route-sub"><span>Tu directorio</span></div>
            </div>

            <div class="search-row">
                <div class="search-box-live">
                    <span class="search-icon"><i class="fa fa-search" aria-hidden="true"/></span>
                    <input
                        type="text"
                        placeholder="Buscar cliente por nombre o dirección…"
                        t-model="state.busqueda"
                        autocomplete="off"
                    />
                </div>
            </div>

            <div class="view">
                <div t-if="state.cargando" class="shalom-vacio">Cargando tus clientes…</div>
                <t t-elif="clientesFiltrados.length === 0">
                    <div class="shalom-vacio" t-if="state.clientes.length === 0">
                        Todavía no tenés clientes asignados.
                    </div>
                    <div class="shalom-vacio" t-else="">
                        Ningún cliente coincide con la búsqueda.
                    </div>
                </t>
                <t t-else="">
                    <div
                        class="stop-card cliente-card"
                        t-foreach="clientesFiltrados"
                        t-as="cliente"
                        t-key="cliente.id"
                        t-on-click="() => this.abrirEdicion(cliente)"
                    >
                        <div class="stop-num" t-esc="cliente.x_orden_ruta || '-'"/>
                        <div class="stop-info">
                            <div class="name" t-esc="cliente.name"/>
                            <div class="addr" t-esc="cliente.street"/>
                            <div class="route-tag" t-if="cliente.fsm_route_name" t-esc="cliente.fsm_route_name"/>
                            <div class="route-tag route-tag-sin-asignar" t-else="">Sin ruta asignada</div>
                        </div>
                        <span class="quick-icon-btn" title="Llamar" t-on-click.stop="() => this.llamar(cliente)"><i class="fa fa-phone" aria-hidden="true"/></span>
                        <span class="quick-icon-btn" title="Ir con Waze" t-on-click.stop="() => this.abrirMaps(cliente)"><i class="fa fa-location-arrow" aria-hidden="true"/></span>
                    </div>
                </t>
            </div>

            <button class="fab-add" t-on-click="abrirAlta" title="Agregar cliente nuevo">+</button>
        </div>

        <ClienteForm
            t-if="state.formularioAbierto"
            modo="state.modoFormulario"
            locationId="state.locationIdEditando"
            onGuardado.bind="formularioGuardado"
            onCancelar.bind="cerrarFormulario"
        />
    </t>
</templates>
