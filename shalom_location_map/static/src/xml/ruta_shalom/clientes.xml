<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.Clientes">
        <div class="shalom-screen clientes-screen">
            <div class="topbar topbar-nivel3">
                <div class="topbar-row">
                    <div class="topbar-title">
                        <div class="paso-etiqueta">DIRECTORIO</div>
                        <div class="route-name">Clientes</div>
                        <div class="route-sub"><span>Tu directorio</span></div>
                    </div>
                    <TemaSelector/>
                </div>
            </div>

            <div class="search-row">
                <div class="search-box-live">
                    <span class="search-icon"><i class="fa fa-search" aria-hidden="true"/></span>
                    <input
                        type="text"
                        placeholder="Buscar cliente por nombre o dirección…"
                        t-model="state.busqueda"
                        autocomplete="off"
                    />
                </div>
            </div>

            <div class="view">
                <div t-if="state.cargando" class="shalom-vacio">Cargando tus clientes…</div>
                <t t-elif="clientesFiltrados.length === 0">
                    <div class="shalom-vacio" t-if="state.clientes.length === 0">
                        Todavía no tenés clientes asignados.
                    </div>
                    <div class="shalom-vacio" t-else="">
                        Ningún cliente coincide con la búsqueda.
                    </div>
                </t>
                <t t-else="">
                    <div
                        class="stop-card cliente-card"
                        t-foreach="clientesFiltrados"
                        t-as="cliente"
                        t-key="cliente.id"
                        t-on-click="() => this.abrirEdicion(cliente)"
                    >
                        <div class="cliente-avatar" t-esc="iniciales(cliente)"/>
                        <div class="stop-info">
                            <div class="name"><t t-esc="cliente.name"/><t t-if="esSinEnviar(cliente)"><span class="off-nuevo">NUEVO</span><span class="off-marca"><i class="fa fa-cloud-upload" aria-hidden="true"/> Sin enviar</span></t></div>
                            <div class="addr" t-esc="cliente.street"/>
                            <div class="addr" t-if="cliente.street2" t-esc="cliente.street2"/>
                            <div class="route-tag" t-if="cliente.fsm_route_name" t-esc="cliente.fsm_route_name + (cliente.x_orden_ruta ? ' · parada ' + cliente.x_orden_ruta : '')"/>
                            <div class="route-tag route-tag-sin-asignar" t-else="">Sin ruta asignada</div>
                        </div>
                        <span class="quick-icon-btn" title="Llamar" t-on-click.stop="() => this.llamar(cliente)"><i class="fa fa-phone" aria-hidden="true"/></span>
                        <span class="quick-icon-btn" title="Ir con Waze" t-on-click.stop="() => this.abrirMaps(cliente)"><i class="fa fa-location-arrow" aria-hidden="true"/></span>
                    </div>
                </t>
            </div>

            <button class="fab-add" t-on-click="abrirAlta" title="Agregar cliente nuevo">+</button>
        </div>

        <!-- Cliente creado (mockup aprobado "Cliente nuevo sin señal", lámina 2) -->
        <div class="cc-overlay" t-if="state.creado" t-on-click.self="cerrarCreado">
            <div class="cc-hoja" role="dialog" aria-label="Cliente creado">
                <div class="cc-asa"/>
                <div class="cc-cabeza">
                    <div class="cc-ok"><i class="fa fa-check" aria-hidden="true"/></div>
                    <div>
                        <div class="cc-titulo">Cliente creado</div>
                        <div class="cc-nombre" t-esc="state.creado.nombre"/>
                    </div>
                </div>
                <div class="cc-datos">
                    <div><span>Ruta</span><b t-esc="state.creado.rutaNombre"/></div>
                    <div><span>Parada</span><b t-esc="textoParadaCreado"/></div>
                </div>
                <div class="cc-aviso" t-if="state.creado.estado === 'pendiente'">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                    <span>Guardado en el teléfono. Se envía solo cuando vuelva la señal, junto con su pedido.</span>
                </div>
                <div class="cc-aviso" t-if="!puedeTomarPedido">
                    <i class="fa fa-info-circle" aria-hidden="true"/>
                    <span>Su ruta no tiene un ciclo en curso: el pedido se le podrá hacer cuando oficina lo genere.</span>
                </div>
                <button class="cc-pedido" t-if="puedeTomarPedido" t-on-click="tomarPedidoCreado">
                    <i class="fa fa-shopping-cart" aria-hidden="true"/> Tomar pedido ahora
                </button>
                <button class="cc-listo" t-on-click="cerrarCreado">Listo</button>
            </div>
        </div>

        <ClienteForm
            t-if="state.formularioAbierto"
            modo="state.modoFormulario"
            locationId="state.locationIdEditando"
            nombreInicial="state.nombreInicialAlta"
            onGuardado.bind="formularioGuardado"
            onCancelar.bind="cerrarFormulario"
        />
    </t>
</templates>
