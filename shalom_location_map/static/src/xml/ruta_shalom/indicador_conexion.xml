<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.IndicadorConexion">
        <!-- Mientras "Preparar mi día" descarga: barrita fija arriba de la
             pantalla, visible aunque el panel esté cerrado. -->
        <div class="off-barra-global" t-if="offline.preparando" role="progressbar" t-att-aria-valuenow="offline.progreso" aria-valuemin="0" aria-valuemax="100" t-att-title="offline.mensajePreparar">
            <div class="off-barra-global-relleno" t-att-style="'width:' + Math.max(3, offline.progreso) + '%'"/>
        </div>
        <button t-att-class="clasePastilla + (offline.preparando ? ' off-pill-descargando' : '')" t-on-click="abrir" t-att-title="tituloPastilla" t-att-aria-label="tituloPastilla">
            <span class="off-pill-dot"/>
            <span t-if="!props.compacta" t-attf-class="{{pendientes.length or conError.length ? 'off-pill-pend' : ''}}" t-esc="textoPastilla"/>
            <span t-elif="textoCompacto" class="off-pill-pend" t-esc="textoCompacto"/>
        </button>

        <!-- Panel (diseño aprobado: "Panel de conexión Ruta Shalom") -->
        <div class="off-panel-overlay" t-if="local.panelAbierto" t-on-click.self="cerrar">
            <div class="off-panel" role="dialog" aria-label="Conexión y datos sin señal">
                <div class="off-panel-asa"/>

                <!-- (a) Estado de la conexión -->
                <div t-attf-class="off-estado off-estado-{{offline.red}}">
                    <span class="off-estado-icono"><i t-attf-class="fa {{offline.red === 'sin_senal' ? 'fa-ban' : 'fa-wifi'}}" aria-hidden="true"/></span>
                    <div class="off-estado-textos">
                        <div class="off-estado-titulo">
                            <t t-if="offline.red === 'en_linea'">En línea</t>
                            <t t-elif="offline.red === 'debil'">Señal débil</t>
                            <t t-else="">Sin señal</t>
                        </div>
                        <div class="off-estado-sub" t-esc="textoEstadoRed"/>
                    </div>
                </div>

                <!-- (b) Datos en este teléfono -->
                <div class="off-seccion-cab">
                    <div class="off-seccion-titulo">Datos en este teléfono</div>
                    <span t-attf-class="off-chip off-chip-{{datos.frescura}}">
                        <i t-attf-class="fa {{datos.frescura === 'al_dia' ? 'fa-check' : datos.frescura === 'actualizar' ? 'fa-clock-o' : 'fa-exclamation'}}" aria-hidden="true"/>
                        <t t-esc="etiquetaFrescura"/>
                    </span>
                </div>
                <div class="off-checklist">
                    <button class="off-check off-check-boton" t-on-click="toggleRutas" t-att-aria-expanded="local.verRutas ? 'true' : 'false'">
                        <span class="off-check-ico"><i class="fa fa-map-o" aria-hidden="true"/></span>
                        <span class="off-check-textos">
                            <span class="off-check-titulo">Rutas y clientes</span>
                            <span class="off-check-sub" t-esc="textoRutas"/>
                            <span class="off-check-alerta" t-if="datos.rutasNuevas">
                                <t t-esc="datos.rutasNuevas"/> ruta<t t-if="datos.rutasNuevas !== 1">s</t> nueva<t t-if="datos.rutasNuevas !== 1">s</t> sin descargar
                            </span>
                        </span>
                        <i t-attf-class="fa {{local.verRutas ? 'fa-chevron-up' : 'fa-chevron-down'}} off-tarjeta-flecha" aria-hidden="true"/>
                    </button>
                    <!-- Cuáles rutas están en el teléfono y cuáles no -->
                    <div class="off-rutas-lista" t-if="local.verRutas">
                        <div t-if="!datos.rutasLista.length" class="off-ruta-fila off-check-sub">Todavía no hay rutas guardadas.</div>
                        <div t-foreach="datos.rutasLista" t-as="ruta" t-key="ruta.id" t-attf-class="off-ruta-fila {{ruta.descargada ? '' : 'off-ruta-falta'}}">
                            <i t-attf-class="fa {{ruta.descargada ? 'fa-check off-check-ok' : 'fa-circle-o off-check-viejo'}}" aria-hidden="true"/>
                            <span class="off-ruta-nombre" t-esc="ruta.nombre"/>
                            <span class="off-ruta-dato" t-if="ruta.descargada">
                                <t t-if="ruta.clientes !== null"><t t-esc="ruta.clientes"/> clientes · </t><t t-esc="ruta.hora"/>
                            </span>
                            <span class="off-ruta-dato off-ruta-dato-falta" t-else="">Sin descargar</span>
                        </div>
                    </div>
                    <div class="off-check">
                        <span class="off-check-ico"><i class="fa fa-cube" aria-hidden="true"/></span>
                        <div class="off-check-textos">
                            <div class="off-check-titulo">Catálogo, precios y existencias</div>
                            <div class="off-check-sub" t-esc="textoCatalogo"/>
                        </div>
                        <i t-attf-class="fa off-check-estado off-check-{{iconoDatos}} {{iconoDatos === 'ok' ? 'fa-check-circle' : iconoDatos === 'viejo' ? 'fa-exclamation-circle' : 'fa-circle-o'}}" aria-hidden="true"/>
                    </div>
                    <div class="off-check">
                        <span class="off-check-ico"><i class="fa fa-picture-o" aria-hidden="true"/></span>
                        <div class="off-check-textos">
                            <div class="off-check-titulo">Fotos del catálogo</div>
                            <div class="off-check-sub" t-esc="textoFotos"/>
                        </div>
                        <i t-attf-class="fa off-check-estado {{offline.fotosEn ? 'off-check-ok fa-check-circle' : 'off-check-falta fa-circle-o'}}" aria-hidden="true"/>
                    </div>
                    <div class="off-check">
                        <span class="off-check-ico"><i class="fa fa-database" aria-hidden="true"/></span>
                        <div class="off-check-textos">
                            <div class="off-check-titulo">Espacio usado</div>
                            <div class="off-check-sub" t-esc="textoEspacio"/>
                        </div>
                        <button class="off-borrar" t-if="offline.preparadoEn" t-att-disabled="offline.preparando" t-on-click="borrarDatos">Borrar</button>
                    </div>
                </div>

                <!-- (c) Aviso y opciones de la descarga (no hace falta si ya está todo al día) -->
                <t t-if="datos.frescura !== 'al_dia' or offline.preparando">
                    <div class="off-aviso">
                        <i class="fa fa-info-circle" aria-hidden="true"/>
                        <div><b>Se bajan todas las rutas con clientes pendientes.</b> Con señal débil puede tardar: mejor con Wi-Fi antes de salir.</div>
                    </div>
                    <label class="off-interruptor">
                        <span class="off-interruptor-textos">
                            <span class="off-interruptor-titulo">Incluir fotos del catálogo</span>
                            <span class="off-check-sub">Pesan bastante la primera vez · después solo las que cambien</span>
                        </span>
                        <input type="checkbox" t-att-checked="local.fotos" t-on-change="toggleFotos" t-att-disabled="offline.preparando"/>
                    </label>
                </t>
                <button
                    t-attf-class="off-btn {{datos.frescura === 'al_dia' and !offline.preparando ? 'off-btn-ghost' : ''}}"
                    t-if="!local.confirmandoDescarga"
                    t-att-disabled="offline.preparando or offline.red === 'sin_senal'"
                    t-on-click="preparar"
                >
                    <i t-attf-class="fa {{datos.frescura === 'al_dia' ? 'fa-refresh' : 'fa-download'}}" aria-hidden="true"/>
                    <t t-esc="' ' + textoBotonPreparar"/>
                </button>
                <!-- Todo al día: confirmar antes de volver a descargar -->
                <div class="off-confirmacion" t-if="local.confirmandoDescarga" role="alertdialog" aria-label="Ya tienes todo descargado">
                    <div class="off-confirmacion-cab">
                        <i class="fa fa-check-circle off-check-ok" aria-hidden="true"/>
                        <div>
                            <div class="off-tarjeta-titulo">Ya tienes todo descargado</div>
                            <div class="off-check-sub">Descargaste <t t-esc="datos.cuando"/>. Si descargas de nuevo, se reemplaza lo anterior: no ocupa espacio extra.</div>
                        </div>
                    </div>
                    <div class="off-acciones-2">
                        <button class="off-btn off-btn-chico off-btn-ghost" t-on-click="noDescargar">No, está bien</button>
                        <button class="off-btn off-btn-chico" t-on-click="descargarIgual">Descargar igual</button>
                    </div>
                </div>
                <t t-if="offline.preparando or offline.mensajePreparar">
                    <div class="off-progreso"><div class="off-progreso-barra" t-att-style="'width:' + offline.progreso + '%'"/></div>
                    <div class="off-check-sub" t-esc="offline.mensajePreparar"/>
                </t>

                <!-- (d) Necesita atención (rechazado por el servidor) -->
                <t t-if="conError.length">
                    <div class="off-seccion-cab">
                        <div class="off-seccion-titulo off-seccion-titulo-error">Necesita atención</div>
                        <span class="off-contador off-contador-error" t-esc="conError.length"/>
                    </div>
                    <div t-foreach="conError" t-as="item" t-key="item.uuid" class="off-tarjeta off-tarjeta-error">
                        <div class="off-tarjeta-cab">
                            <span class="off-tarjeta-ico"><i class="fa fa-exclamation-circle" aria-hidden="true"/></span>
                            <div class="off-tarjeta-textos">
                                <div class="off-tarjeta-titulo"><t t-esc="etiquetaItem(item).split(':')[0]"/> · <t t-esc="clienteItem(item)"/></div>
                                <div class="off-tarjeta-sub">
                                    <t t-if="detalleItem(item)"><t t-esc="detalleItem(item)"/> · </t><t t-esc="horaItem(item)"/> · no entró al sistema
                                </div>
                            </div>
                            <div class="off-tarjeta-total" t-if="totalItem(item)" t-esc="totalItem(item)"/>
                        </div>
                        <div class="off-tarjeta-cuerpo">
                            <div class="off-motivo">
                                <i class="fa fa-comment-o" aria-hidden="true"/>
                                <div><b>Motivo:</b> <t t-esc="item.error"/></div>
                            </div>
                            <div class="off-acciones-2">
                                <button class="off-btn off-btn-chico" t-on-click="() => this.reintentar(item)">Reintentar</button>
                                <button class="off-btn off-btn-chico off-btn-blanco" t-on-click="() => this.descartar(item)">Descartar</button>
                            </div>
                            <t t-if="lineasItem(item).length">
                                <button class="off-enlace" t-on-click="() => this.toggleItem(item)">
                                    <t t-esc="local.abiertoUuid === item.uuid ? 'Ocultar los productos' : 'Ver los productos'"/>
                                </button>
                                <t t-if="local.abiertoUuid === item.uuid" t-call="shalom_location_map.IndicadorConexionLineas"/>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- (d) Esperando señal -->
                <div class="off-seccion-cab">
                    <div class="off-seccion-titulo">Esperando señal</div>
                    <span t-attf-class="off-contador {{pendientes.length ? 'off-contador-pend' : ''}}" t-esc="pendientes.length"/>
                </div>
                <div t-if="!pendientes.length" class="off-vacio">
                    <i class="fa fa-check" aria-hidden="true"/>
                    <t t-esc="conError.length ? 'Lo demás ya está en el sistema.' : 'Nada esperando: todo está en el sistema.'"/>
                </div>
                <div t-foreach="pendientes" t-as="item" t-key="item.uuid" t-attf-class="off-tarjeta {{esPedido(item) ? 'off-tarjeta-pedido' : ''}}">
                    <button class="off-tarjeta-cab" t-on-click="() => this.toggleItem(item)" t-att-aria-expanded="local.abiertoUuid === item.uuid ? 'true' : 'false'">
                        <span class="off-tarjeta-ico">
                            <i t-attf-class="fa {{esPedido(item) ? 'fa-shopping-cart' : item.tipo === 'observacion' ? 'fa-comment-o' : item.tipo === 'gps' ? 'fa-crosshairs' : item.tipo === 'descartar_carrito' ? 'fa-trash-o' : 'fa-check'}}" aria-hidden="true"/>
                        </span>
                        <span class="off-tarjeta-textos">
                            <span class="off-tarjeta-titulo"><t t-esc="etiquetaItem(item).split(':')[0]"/> · <t t-esc="clienteItem(item)"/></span>
                            <span class="off-tarjeta-sub">
                                <t t-if="detalleItem(item)"><t t-esc="detalleItem(item)"/> · </t><t t-esc="horaItem(item)"/> · esperando señal
                            </span>
                        </span>
                        <span class="off-tarjeta-total" t-if="totalItem(item)" t-esc="totalItem(item)"/>
                        <i t-attf-class="fa {{local.abiertoUuid === item.uuid ? 'fa-chevron-up' : 'fa-chevron-down'}} off-tarjeta-flecha" aria-hidden="true"/>
                    </button>
                    <div class="off-tarjeta-cuerpo" t-if="local.abiertoUuid === item.uuid">
                        <t t-if="lineasItem(item).length" t-call="shalom_location_map.IndicadorConexionLineas"/>
                        <div class="off-check-sub" t-elif="item.resumen and item.resumen.texto" t-esc="item.resumen.texto"/>
                        <button class="off-btn off-btn-chico off-btn-peligro" t-att-disabled="offline.enviando" t-on-click="() => this.eliminar(item)">
                            <i class="fa fa-trash-o" aria-hidden="true"/>
                            <t t-esc="esPedido(item) ? ' Eliminar este pedido (todavía no se envió)' : ' Eliminar (todavía no se envió)'"/>
                        </button>
                    </div>
                </div>
                <button class="off-btn off-btn-ghost" t-if="pendientes.length and offline.red !== 'sin_senal'" t-att-disabled="offline.enviando" t-on-click="enviarAhora">
                    <t t-esc="offline.enviando ? 'Enviando…' : 'Enviar ahora'"/>
                </button>

                <button class="off-cerrar" t-on-click="cerrar">Cerrar</button>
            </div>
        </div>
    </t>

    <!-- Productos de un pedido guardado en el teléfono (vista previa) -->
    <t t-name="shalom_location_map.IndicadorConexionLineas">
        <div class="off-lineas">
            <div t-foreach="lineasItem(item)" t-as="linea" t-key="linea_index" t-attf-class="off-linea {{linea.recompensa ? 'off-linea-regalo' : ''}}">
                <span class="off-linea-cant"><t t-esc="linea.cantidad"/>×</span>
                <span class="off-linea-nombre"><t t-if="linea.recompensa">Promoción: </t><t t-esc="linea.nombre"/></span>
                <span class="off-linea-precio" t-esc="linea.recompensa ? 'regalo' : '$' + (linea.cantidad * linea.precio).toFixed(2)"/>
            </div>
            <div class="off-lineas-pie">
                <span t-if="item.resumen and item.resumen.forma_pago">Forma de pago: <t t-esc="item.resumen.forma_pago"/></span>
                <span t-else=""/>
                <b t-if="totalItem(item)">Total <t t-esc="totalItem(item)"/></b>
            </div>
        </div>
    </t>
</templates>
