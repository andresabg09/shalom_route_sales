<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.AdminGestion">
        <div class="o_shalom_ruta_app o_shalom_admin_screen">
            <div class="topbar">
                <div class="topbar-row">
                    <div class="topbar-title">
                        <div class="route-name"><i class="fa fa-wrench" aria-hidden="true"/> Administración</div>
                        <div class="route-sub">Seguimiento de visitas y rutas de tus vendedores</div>
                    </div>
                </div>
            </div>

            <div class="segmented">
                <button
                    t-att-class="state.tab === 'seguimiento' ? 'active' : ''"
                    t-on-click="() => this.cambiarTab('seguimiento')"
                ><i class="fa fa-flag" aria-hidden="true"/> Seguimiento de Visitas</button>
                <button
                    t-att-class="state.tab === 'rutas' ? 'active' : ''"
                    t-on-click="() => this.cambiarTab('rutas')"
                ><i class="fa fa-map-o" aria-hidden="true"/> Rutas de mis vendedores</button>
                <button
                    t-att-class="state.tab === 'en_vivo' ? 'active' : ''"
                    t-on-click="() => this.cambiarTab('en_vivo')"
                ><i class="fa fa-eye" aria-hidden="true"/> En vivo</button>
            </div>

            <div class="shalom-body admin-body" t-if="state.tab === 'en_vivo'">
                <!-- ============ En vivo ============ -->
                <div t-if="state.cargandoEnVivo" class="shalom-vacio">Cargando…</div>
                <div t-elif="!state.visitasEnVivo.length" class="shalom-vacio">
                    No hay catálogos abiertos en este momento.
                </div>
                <t t-else="">
                    <div class="admin-visitas-count">
                        <t t-esc="state.visitasEnVivo.length"/> catálogo(s) abierto(s) ahora
                    </div>
                    <div class="admin-visitas-list">
                        <div
                            t-foreach="state.visitasEnVivo"
                            t-as="visita"
                            t-key="visita.id"
                            class="stop-card admin-visit-card"
                            t-on-click="() => this.abrirEnVivo(visita)"
                        >
                            <div class="stop-info">
                                <div class="name">
                                    <i class="fa fa-circle" aria-hidden="true" style="color:#d9534f;font-size:0.55em;margin-right:6px;"/>
                                    <t t-esc="visita.cliente_nombre"/>
                                </div>
                                <div class="addr">
                                    <t t-esc="(visita.ruta_nombre || 'Sin ruta') + ' · ' + (visita.vendedor_nombre || 'Sin vendedor')"/>
                                </div>
                            </div>
                            <div class="stop-right">
                                <span class="stop-badge">Catálogo abierto</span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <div class="shalom-body admin-body" t-if="state.tab === 'seguimiento'">
                <!-- ============ Seguimiento de Visitas ============ -->
                <!-- Columna de filtros a la izquierda + lista a la
                     derecha (mockup aprobado); apiladas en mobile,
                     ver media query de .admin-seguimiento-columnas. -->
                <div class="admin-seguimiento-columnas">
                    <div class="admin-seguimiento-filtros-col">
                        <div class="search-row" t-if="state.visitas.length">
                            <div class="search-box-live">
                                <span><i class="fa fa-search" aria-hidden="true"/></span>
                                <input
                                    type="text"
                                    placeholder="Buscar cliente por nombre…"
                                    t-model="state.busquedaVisita"
                                />
                            </div>
                        </div>

                        <div class="admin-filters-card">
                            <div class="admin-filtro-titulo">Estado</div>
                            <div class="filters admin-filters">
                                <button
                                    t-foreach="estadosDisponibles"
                                    t-as="estado"
                                    t-key="estado"
                                    t-attf-class="chip {{state.estadosActivos.includes(estado) ? 'chip-active st-' + estado : ''}}"
                                    t-on-click="() => this.toggleEstado(estado)"
                                ><t t-esc="etiquetaEstado(estado)"/></button>
                            </div>
                        </div>

                        <div class="admin-filters-card" t-if="state.visitas.length">
                            <div class="admin-filtro-titulo">Filtrar por</div>
                            <div class="admin-filtro-mini">
                                <label for="shalom-admin-sel-filtro-vendedor"><i class="fa fa-user" aria-hidden="true"/> Vendedor</label>
                                <select id="shalom-admin-sel-filtro-vendedor" t-on-change="elegirFiltroVendedor">
                                    <option value="">Todos</option>
                                    <option
                                        t-foreach="vendedoresConVisitas"
                                        t-as="nombreVendedor"
                                        t-key="nombreVendedor"
                                        t-att-value="nombreVendedor"
                                        t-att-selected="nombreVendedor === state.filtroVendedorNombre"
                                    ><t t-esc="nombreVendedor"/></option>
                                </select>
                            </div>
                            <div class="admin-filtro-mini">
                                <label for="shalom-admin-sel-filtro-ruta"><i class="fa fa-map-o" aria-hidden="true"/> Ruta</label>
                                <select id="shalom-admin-sel-filtro-ruta" t-on-change="elegirFiltroRuta">
                                    <option value="">Todas</option>
                                    <option
                                        t-foreach="rutasConVisitas"
                                        t-as="nombreRuta"
                                        t-key="nombreRuta"
                                        t-att-value="nombreRuta"
                                        t-att-selected="nombreRuta === state.filtroRutaNombre"
                                    ><t t-esc="nombreRuta"/></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="admin-seguimiento-lista-col">
                        <div t-if="state.cargandoVisitas" class="shalom-vacio">Cargando…</div>
                        <div t-elif="!state.visitas.length" class="shalom-vacio">
                            No hay visitas con los estados elegidos.
                        </div>
                        <div t-elif="!visitasFiltradas.length" class="shalom-vacio">
                            No hay visitas con ese vendedor/ruta.
                        </div>
                        <t t-else="">
                            <div class="admin-visitas-count">
                                <t t-esc="visitasFiltradas.length"/> <t t-esc="visitasFiltradas.length === 1 ? 'visita' : 'visitas'"/>
                            </div>
                            <div class="admin-visitas-list">
                                <div
                                    t-foreach="visitasFiltradas"
                                    t-as="visita"
                                    t-key="visita.id"
                                    t-attf-class="stop-card admin-visit-card st-{{visita.estado}}"
                                    t-on-click="() => this.abrirEdicionCliente(visita.location_id)"
                                >
                                    <div class="stop-info">
                                        <div class="name">
                                            <t t-esc="visita.cliente_nombre"/>
                                            <span class="edit-nombre-btn" title="Editar cliente">
                                                <i class="fa fa-pencil" aria-hidden="true"/>
                                            </span>
                                        </div>
                                        <div class="addr">
                                            <t t-esc="(visita.ruta_nombre || 'Sin ruta') + ' · ' + (visita.vendedor_nombre || 'Sin vendedor')"/>
                                        </div>
                                        <div class="admin-obs" t-if="visita.observaciones" t-esc="visita.observaciones"/>
                                    </div>
                                    <div class="stop-right">
                                        <span class="stop-badge"><t t-esc="etiquetaEstado(visita.estado)"/></span>
                                        <span class="admin-fecha" t-esc="visita.fecha"/>
                                        <button
                                            t-attf-class="btn-mini-admin {{visita.revisado ? 'revisado' : ''}}"
                                            t-on-click="(ev) => this.toggleRevisado(ev, visita)"
                                        ><t t-esc="visita.revisado ? '✓ Revisado' : 'Marcar revisado'"/></button>
                                        <button
                                            t-if="visita.estado === 'cancelado'"
                                            class="btn-mini-admin danger"
                                            t-on-click="(ev) => this.archivarCliente(ev, visita)"
                                        >Archivar cliente</button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="shalom-body admin-body" t-if="state.tab === 'rutas'">
                <!-- ============ Rutas de mis vendedores ============ -->
                <div t-if="state.cargandoVendedores" class="shalom-vacio">Cargando…</div>
                <div t-elif="!state.vendedores.length" class="shalom-vacio">
                    No hay rutas programadas todavía.
                </div>
                <t t-else="">
                    <!-- Pastilla de vendedor + ruteros compactos:
                         mockup aprobado ("Vista previa: Administración
                         v2"), reemplaza las tarjetas grandes con
                         sombra de la ronda anterior, mismo <select>
                         nativo por debajo (accesible, sin reinventar
                         un dropdown a medida), solo el CSS cambia. -->
                    <div class="admin-vendedor-pill">
                        <span class="admin-vendedor-pill-avatar"><i class="fa fa-user" aria-hidden="true"/></span>
                        <select id="shalom-admin-sel-vendedor" t-on-change="elegirVendedor">
                            <option
                                t-foreach="state.vendedores"
                                t-as="vendedor"
                                t-key="vendedor.persona_id"
                                t-att-value="vendedor.persona_id"
                                t-att-selected="vendedor.persona_id === state.vendedorSeleccionadoId"
                            ><t t-esc="vendedor.persona_nombre + ' -- ' + vendedor.rutas.length + (vendedor.rutas.length === 1 ? ' ruta' : ' rutas')"/></option>
                        </select>
                        <i class="fa fa-chevron-down admin-vendedor-pill-flecha" aria-hidden="true"/>
                    </div>

                    <div class="admin-route-chip-row" t-if="vendedorSeleccionado">
                        <button
                            t-foreach="vendedorSeleccionado.rutas"
                            t-as="ruta"
                            t-key="ruta.id"
                            t-attf-class="admin-route-pill {{state.scheduleSeleccionadoId === ruta.id ? 'admin-route-pill-active' : ''}} {{ruta.es_visita_express ? 'admin-route-pill-express' : ''}}"
                            t-on-click="() => this.elegirRuta(ruta)"
                        >
                            <i t-if="ruta.es_visita_express" class="fa fa-bolt" aria-hidden="true"/>
                            <t t-esc="ruta.route_name"/>
                            <span class="admin-route-pill-count">· <t t-esc="ruta.cantidad_clientes"/></span>
                        </button>
                    </div>

                    <!-- Visita Exprés: la de ESTE vendedor específico
                         (el elegido arriba), separada de sus rutas
                         normales. Ver docstring grande de la sección en
                         admin_gestion.js. -->
                    <div class="admin-express-wrap" t-if="vendedorSeleccionado">
                        <button
                            t-attf-class="admin-express-pill {{state.visitaExpressAbierta ? 'admin-express-pill-active' : ''}}"
                            t-on-click="abrirVisitaExpress"
                        >
                            <i class="fa fa-bolt" aria-hidden="true"/> Visita Exprés
                            <span class="admin-express-pill-count" t-if="state.visitaExpressClientes.length">
                                · <t t-esc="state.visitaExpressClientes.length"/>
                            </span>
                        </button>

                        <div class="admin-express-panel" t-if="state.visitaExpressAbierta">
                            <div t-if="state.visitaExpressCargando" class="shalom-vacio">Cargando…</div>
                            <t t-else="">
                                <!-- Inicio/Fin: SIEMPRE editable, tenga
                                     o no ya una ocurrencia creada
                                     (pedido explícito). Mismo widget de
                                     calendario nativo que ya se usa al
                                     programar una ruta, no un campo de
                                     texto libre. Si la ocurrencia ya
                                     existe, cada cambio se guarda solo
                                     (ver onCambiarFechaInicioVisitaExpress/
                                     onCambiarFechaFinVisitaExpress en
                                     admin_gestion.js). -->
                                <div class="admin-express-fecha-row">
                                    <div class="admin-express-fecha-campo">
                                        <label>Fecha de inicio</label>
                                        <DateTimeInput
                                            type="'date'"
                                            value="state.visitaExpressFechaInicio"
                                            onChange.bind="onCambiarFechaInicioVisitaExpress"
                                        />
                                    </div>
                                    <div class="admin-express-fecha-campo">
                                        <label>Fecha de fin</label>
                                        <DateTimeInput
                                            type="'date'"
                                            value="state.visitaExpressFechaFin"
                                            onChange.bind="onCambiarFechaFinVisitaExpress"
                                        />
                                    </div>
                                </div>
                                <div class="admin-express-header">
                                    <button class="btn-mini-admin" t-on-click="abrirBuscadorVisitaExpress">
                                        <i class="fa fa-plus" aria-hidden="true"/> Agregar cliente
                                    </button>
                                </div>

                                <div t-if="!state.visitaExpressClientes.length" class="shalom-vacio">
                                    No hay clientes confirmados en Visita Exprés todavía.
                                </div>
                                <div class="admin-stop-list" t-else="">
                                    <div
                                        t-foreach="state.visitaExpressClientes"
                                        t-as="cliente"
                                        t-key="cliente.order_id"
                                        class="stop-row admin-cliente-row"
                                    >
                                        <span class="nombre" t-esc="cliente.cliente_nombre"/>
                                        <span
                                            class="stop-icon-btn"
                                            title="Editar cliente"
                                            t-on-click="(ev) => this.abrirEdicionCliente(cliente.location_id, ev)"
                                        ><i class="fa fa-pencil" aria-hidden="true"/><span class="stop-icon-btn-label">Editar</span></span>
                                        <span
                                            class="stop-icon-btn stop-icon-btn-accent"
                                            title="Buscar GPS por nombre (Google)"
                                            t-on-click="(ev) => this.buscarGps(ev, cliente.location_id)"
                                        ><i class="fa fa-crosshairs" aria-hidden="true"/><span class="stop-icon-btn-label">GPS</span></span>
                                        <span
                                            class="stop-icon-btn stop-icon-btn-danger"
                                            title="Archivar visita"
                                            t-on-click="(ev) => this.archivarVisitaExpress(ev, cliente)"
                                        ><i class="fa fa-trash-o" aria-hidden="true"/><span class="stop-icon-btn-label">Eliminar</span></span>
                                    </div>
                                </div>

                                <!-- Por confirmar: elegidos con el
                                     buscador pero TODAVÍA sin tocar la
                                     base. Ver docstring grande de la
                                     sección en admin_gestion.js. -->
                                <t t-if="state.visitaExpressPendientes.length">
                                    <div class="admin-express-pendientes-titulo">
                                        Por confirmar (<t t-esc="state.visitaExpressPendientes.length"/>)
                                    </div>
                                    <div class="admin-stop-list">
                                        <div
                                            t-foreach="state.visitaExpressPendientes"
                                            t-as="pendiente"
                                            t-key="pendiente.id"
                                            class="stop-row admin-express-pendiente-row"
                                        >
                                            <div class="admin-express-resultado-info">
                                                <span class="nombre" t-esc="pendiente.name"/>
                                                <span t-attf-class="admin-express-resultado-sub {{pendiente.expandido ? 'admin-express-resultado-sub-expandido' : ''}}">
                                                    <t t-esc="pendiente.ruta_nombre || 'Sin ruta'"/>
                                                    <t t-if="pendiente.vendedor_nombre"> · <t t-esc="pendiente.vendedor_nombre"/></t>
                                                    <t t-if="pendiente.street"> · <t t-esc="pendiente.street"/></t>
                                                </span>
                                            </div>
                                            <span
                                                class="stop-icon-btn admin-express-expandir-btn"
                                                title="Ver completo"
                                                t-on-click="(ev) => this.toggleExpandido(pendiente, ev)"
                                            ><i t-attf-class="fa {{pendiente.expandido ? 'fa-chevron-up' : 'fa-chevron-down'}}" aria-hidden="true"/></span>
                                            <span
                                                class="stop-icon-btn stop-icon-btn-danger"
                                                title="Quitar de la lista"
                                                t-on-click="() => this.quitarPendienteVisitaExpress(pendiente)"
                                            ><i class="fa fa-times" aria-hidden="true"/></span>
                                        </div>
                                    </div>
                                    <button
                                        class="btn btn-primary admin-express-confirmar-btn"
                                        t-att-disabled="state.visitaExpressConfirmando"
                                        t-on-click="confirmarLoteVisitaExpress"
                                    >
                                        <t t-if="state.visitaExpressConfirmando">Confirmando…</t>
                                        <t t-else="">
                                            Confirmar Visita Exprés (<t t-esc="state.visitaExpressPendientes.length"/>)
                                        </t>
                                    </button>
                                </t>
                            </t>
                        </div>
                    </div>

                    <!-- Mapa a la izquierda, lista de clientes a la
                         derecha (desktop); apilados en mobile, ver
                         media query de .admin-rutas-columnas. -->
                    <div class="admin-rutas-columnas" t-if="state.scheduleSeleccionadoId">
                        <div class="admin-mapa-wrap">
                            <div class="admin-mapa-chip" t-if="rutaSeleccionada">
                                <i class="fa fa-map-o" aria-hidden="true"/>
                                <t t-esc="rutaSeleccionada.route_name"/>
                                <span class="admin-mapa-chip-count">· <t t-esc="rutaSeleccionada.cantidad_clientes"/> paradas</span>
                            </div>
                            <div class="admin-mapa" t-ref="mapaAdmin"/>
                        </div>

                        <div class="admin-rutas-lista-col">
                            <div class="search-row" t-if="state.clientesRuta.length">
                                <div class="search-box-live">
                                    <span><i class="fa fa-search" aria-hidden="true"/></span>
                                    <input
                                        type="text"
                                        placeholder="Buscar cliente en esta ruta…"
                                        t-model="state.busquedaClienteRuta"
                                    />
                                </div>
                            </div>

                            <div t-if="state.cargandoClientesRuta" class="shalom-vacio">Cargando clientes…</div>
                            <div t-elif="!state.clientesRuta.length" class="shalom-vacio">
                                No hay clientes en esta ruta.
                            </div>
                            <div t-elif="!clientesRutaFiltrados.length" class="shalom-vacio">
                                No hay clientes con ese nombre.
                            </div>
                            <div class="admin-stop-list" t-else="">
                                <div
                                    t-foreach="clientesRutaFiltrados"
                                    t-as="cliente"
                                    t-key="cliente.ordenId"
                                    t-attf-class="stop-row admin-cliente-row st-{{cliente.estado}} {{cliente.ordenId === state.clienteResaltadoId ? 'resaltado' : ''}}"
                                    t-att-data-orden-id="cliente.ordenId"
                                    title="Ubicar en el mapa"
                                    t-on-click="() => this.resaltarDesdeLista(cliente)"
                                >
                                    <span class="idx" t-esc="cliente.orden || '-'"/>
                                    <span class="nombre" t-esc="cliente.nombre"/>
                                    <span class="flag-mini" t-if="!cliente.lat and !cliente.lng">
                                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/> sin GPS
                                    </span>
                                    <span
                                        class="stop-icon-btn"
                                        title="Editar cliente"
                                        t-on-click="(ev) => this.abrirEdicionCliente(cliente.locationId, ev)"
                                    ><i class="fa fa-pencil" aria-hidden="true"/><span class="stop-icon-btn-label">Editar</span></span>
                                    <span
                                        class="stop-icon-btn stop-icon-btn-accent"
                                        title="Buscar GPS por nombre (Google)"
                                        t-on-click="(ev) => this.buscarGps(ev, cliente.locationId)"
                                    ><i class="fa fa-crosshairs" aria-hidden="true"/><span class="stop-icon-btn-label">GPS</span></span>
                                    <span
                                        class="stop-icon-btn stop-icon-btn-danger"
                                        title="Archivar visita (no borra al cliente)"
                                        t-on-click="(ev) => this.archivarVisita(ev, cliente)"
                                    ><i class="fa fa-trash-o" aria-hidden="true"/><span class="stop-icon-btn-label">Eliminar</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Bug real reportado y confirmado: este componente vivía
                 como HERMANO de .o_shalom_ruta_app (fuera de este div),
                 en vez de adentro como en cliente_form/ruta_detalle.xml.
                 El modal ".edit-overlay"/".edit-card" está definido en
                 el SCSS anidado bajo .o_shalom_ruta_app, así que nunca
                 matcheaba: el popup "abría" (el t-if se volvía true)
                 pero sin ningún estilo, invisible/colapsado. -->
            <ClienteForm
                t-if="state.locationIdEditando"
                modo="'editar'"
                locationId="state.locationIdEditando"
                onGuardado.bind="clienteEditado"
                onCancelar.bind="cerrarEdicionCliente"
            />

            <!-- "En vivo": mismo componente de catálogo/carrito del
                 vendedor, abierto encima de todo. Ver el docstring
                 de la sección "En vivo" en admin_gestion.js. -->
            <OrderScreen
                t-if="state.orderIdEnVivo"
                orderId="state.orderIdEnVivo"
                clienteNombre="state.clienteEnVivoNombre"
                onCerrar.bind="cerrarEnVivo"
                onConfirmado.bind="cerrarEnVivo"
                onRevisado.bind="cerrarEnVivo"
            />

            <!-- Buscador de Visita Exprés: se queda abierto entre un
                 agregado y el siguiente. Ver docstring grande de la
                 sección en admin_gestion.js. -->
            <div class="confirm-overlay" t-if="state.visitaExpressBuscadorAbierto">
                <div class="confirm-card admin-express-buscador-card">
                    <h3>Agregar cliente a Visita Exprés</h3>
                    <div class="search-row">
                        <div class="search-box-live">
                            <span><i class="fa fa-search" aria-hidden="true"/></span>
                            <input
                                type="text"
                                placeholder="Buscar cliente por nombre…"
                                t-model="state.visitaExpressBusqueda"
                                t-on-input="buscarClienteVisitaExpress"
                            />
                        </div>
                    </div>
                    <div t-if="state.visitaExpressBuscando" class="shalom-vacio">Buscando…</div>
                    <div
                        t-elif="state.visitaExpressBusqueda.trim() and !state.visitaExpressResultados.length"
                        class="shalom-vacio"
                    >
                        No se encontraron clientes.
                    </div>
                    <div class="admin-stop-list" t-else="">
                        <div
                            t-foreach="state.visitaExpressResultados"
                            t-as="resultado"
                            t-key="resultado.id"
                            class="stop-row admin-express-resultado-row"
                            t-on-click="() => this.elegirClienteVisitaExpress(resultado)"
                        >
                            <div class="admin-express-resultado-info">
                                <span class="nombre" t-esc="resultado.name"/>
                                <span t-attf-class="admin-express-resultado-sub {{resultado.expandido ? 'admin-express-resultado-sub-expandido' : ''}}">
                                    <t t-esc="resultado.ruta_nombre || 'Sin ruta'"/>
                                    <t t-if="resultado.vendedor_nombre"> · <t t-esc="resultado.vendedor_nombre"/></t>
                                    <t t-if="resultado.street"> · <t t-esc="resultado.street"/></t>
                                </span>
                            </div>
                            <span
                                class="stop-icon-btn admin-express-expandir-btn"
                                title="Ver completo"
                                t-on-click="(ev) => this.toggleExpandido(resultado, ev)"
                            ><i t-attf-class="fa {{resultado.expandido ? 'fa-chevron-up' : 'fa-chevron-down'}}" aria-hidden="true"/></span>
                            <span class="stop-icon-btn stop-icon-btn-accent"><i class="fa fa-plus" aria-hidden="true"/></span>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cerrarBuscadorVisitaExpress">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
