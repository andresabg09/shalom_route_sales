<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.ClienteForm">
        <div class="edit-overlay open" t-att-class="state.cerrando ? 'closing' : ''">
            <div class="edit-card cliente-form-card" t-att-class="state.cerrando ? 'closing' : ''">
                <div class="cliente-form-header">
                    <button class="icon-btn" t-on-click="intentarCancelar" title="Atrás">←</button>
                    <h3 t-esc="props.modo === 'crear' ? 'Cliente nuevo' : 'Editar cliente'"/>
                </div>
                <p class="alta-hint" t-if="props.modo === 'crear'">
                    Alta rápida desde la calle -- si no elegís ruta, oficina la
                    asigna después.
                </p>

                <div t-if="state.cargando" class="shalom-vacio">Cargando…</div>
                <t t-else="">
                    <div class="foto-picker">
                        <label class="foto-picker-label" for="shalom-cliente-foto">
                            <img t-if="state.fotoPreviewUrl" class="foto-preview" t-att-src="state.fotoPreviewUrl" alt=""/>
                            <span t-else="" class="foto-picker-placeholder"><i class="fa fa-camera" aria-hidden="true"/> Foto del local</span>
                        </label>
                        <input
                            id="shalom-cliente-foto"
                            type="file"
                            accept="image/*"
                            capture="environment"
                            class="foto-picker-input"
                            t-on-change="onFotoSeleccionada"
                        />
                    </div>

                    <div class="edit-field">
                        <label for="shalom-cf-name">Nombre comercial</label>
                        <input id="shalom-cf-name" type="text" t-model="state.campos.name" t-on-input="marcarModificado"/>
                    </div>
                    <div class="edit-field">
                        <label for="shalom-cf-street">Dirección</label>
                        <input id="shalom-cf-street" type="text" t-model="state.campos.street" t-on-input="marcarModificado"/>
                    </div>
                    <div class="edit-field-row">
                        <div class="edit-field">
                            <label for="shalom-cf-phone">Teléfono</label>
                            <input id="shalom-cf-phone" type="text" t-model="state.campos.phone" t-on-input="marcarModificado"/>
                        </div>
                        <div class="edit-field">
                            <label for="shalom-cf-mobile">Celular</label>
                            <input id="shalom-cf-mobile" type="text" t-model="state.campos.mobile" t-on-input="marcarModificado"/>
                        </div>
                    </div>
                    <div class="edit-field-row">
                        <div class="edit-field">
                            <label for="shalom-cf-email">Correo electrónico</label>
                            <input id="shalom-cf-email" type="email" t-model="state.campos.email" t-on-input="marcarModificado"/>
                        </div>
                        <div class="edit-field">
                            <label for="shalom-cf-vat">RUC</label>
                            <input id="shalom-cf-vat" type="text" t-model="state.campos.vat" t-on-input="marcarModificado"/>
                        </div>
                    </div>

                    <button class="btn btn-secondary gps-btn" t-on-click="capturarGps">
                        <i class="fa fa-crosshairs" aria-hidden="true"/> Registrar coordenadas
                        <t t-if="state.lat"> (capturadas)</t>
                    </button>

                    <div class="edit-field">
                        <label>Ruta</label>
                        <div class="categ-selector-wrap">
                            <button class="categ-selector-btn" t-on-click="toggleMenuRuta">
                                <span t-esc="etiquetaRutaActual"/>
                                <span class="chev">▾</span>
                            </button>
                            <div class="categ-menu" t-if="state.rutaMenuAbierto">
                                <input
                                    type="text"
                                    class="categ-menu-search"
                                    placeholder="Buscar ruta…"
                                    t-model="state.busquedaRuta"
                                />
                                <div class="categ-menu-list">
                                    <button
                                        class="categ-menu-item"
                                        t-att-class="state.rutaId === 'sin_asignar' ? 'categ-menu-item active' : 'categ-menu-item'"
                                        t-on-click="() => this.elegirRuta('sin_asignar')"
                                    >Sin asignar</button>
                                    <button
                                        t-foreach="rutasFiltradas"
                                        t-as="ruta"
                                        t-key="ruta.id"
                                        t-att-class="state.rutaId === ruta.id ? 'categ-menu-item active' : 'categ-menu-item'"
                                        t-on-click="() => this.elegirRuta(ruta.id)"
                                    ><t t-esc="ruta.name"/></button>
                                    <div t-if="!rutasFiltradas.length" class="shalom-vacio">Sin resultados.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="edit-field" t-if="state.rutaId !== 'sin_asignar'">
                        <label>Va después de</label>
                        <div class="categ-selector-wrap">
                            <button class="categ-selector-btn" t-on-click="toggleMenuClienteAnterior">
                                <span t-esc="etiquetaClienteAnteriorActual"/>
                                <span class="chev">▾</span>
                            </button>
                            <div class="categ-menu" t-if="state.clienteAnteriorMenuAbierto">
                                <input
                                    type="text"
                                    class="categ-menu-search"
                                    placeholder="Buscar cliente…"
                                    t-model="state.busquedaClienteAnterior"
                                />
                                <div class="categ-menu-list">
                                    <div t-if="state.cargandoClientesDeRuta" class="shalom-vacio">Cargando…</div>
                                    <t t-else="">
                                        <button
                                            class="categ-menu-item"
                                            t-att-class="state.clienteAnteriorId === 'ninguno' ? 'categ-menu-item active' : 'categ-menu-item'"
                                            t-on-click="() => this.elegirClienteAnterior('ninguno')"
                                        >Primero de la ruta</button>
                                        <button
                                            t-foreach="clientesDeRutaFiltrados"
                                            t-as="cliente"
                                            t-key="cliente.id"
                                            t-att-class="state.clienteAnteriorId === cliente.id ? 'categ-menu-item active' : 'categ-menu-item'"
                                            t-on-click="() => this.elegirClienteAnterior(cliente.id)"
                                        ><t t-esc="cliente.name"/></button>
                                        <div t-if="!clientesDeRutaFiltrados.length" class="shalom-vacio">Sin resultados.</div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="edit-actions">
                    <button class="btn btn-ghost" t-on-click="intentarCancelar">Cancelar</button>
                    <button class="btn btn-primary" t-on-click="guardar" t-att-disabled="state.guardando || state.cargando">
                        <t t-if="state.guardando">Guardando…</t>
                        <t t-elif="props.modo === 'crear'">Crear cliente</t>
                        <t t-else="">Guardar</t>
                    </button>
                </div>
            </div>
        </div>

        <div class="confirm-overlay" t-if="state.confirmandoSalida">
            <div class="confirm-card">
                <h3>¿Salir sin guardar?</h3>
                <p>Hiciste cambios en la ficha de este cliente que todavía no
                    guardaste. Si salís ahora, se pierden.</p>
                <div class="edit-actions">
                    <button class="btn btn-ghost" t-on-click="seguirEditando">Seguir editando</button>
                    <button class="btn btn-primary" t-on-click="confirmarSalirSinGuardar">Salir sin guardar</button>
                </div>
            </div>
        </div>
    </t>
</templates>
