<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.RutasHub">
        <div class="shalom-screen">
            <div class="topbar topbar-nivel1">
                <div class="paso-fila">
                    <span class="paso-chip">PASO 1 DE 3</span>
                    <span class="paso-camino">Ruta → Clientes → Pedido</span>
                </div>
                <div class="topbar-row">
                    <div class="topbar-title">
                        <div class="route-name">Elige tu ruta</div>
                        <div class="route-sub"><span>Todas las rutas con clientes por visitar</span></div>
                    </div>
                    <button class="estrategias-btn" t-if="totalEstrategias" t-on-click="toggleEstrategias">
                        <i class="fa fa-lightbulb-o" aria-hidden="true"/> Estrategias
                    </button>
                    <TemaSelector/>
                </div>
            </div>

            <button class="avisos-btn" title="Avisos por WhatsApp" aria-label="Avisos por WhatsApp" t-if="state.avisosPendientes !== null" t-on-click="abrirAvisos">
                <i class="fa fa-whatsapp" aria-hidden="true"/>
                <span class="avisos-btn-txt">Avisos</span>
                <span class="avisos-btn-cuenta" t-if="state.avisosPendientes" t-esc="state.avisosPendientes"/>
            </button>
            <Avisos t-if="state.avisosAbiertos" onCerrar.bind="cerrarAvisos"/>

            <div class="confirm-overlay" t-if="state.estrategiasAbiertas" t-on-click.self="toggleEstrategias">
                <div class="confirm-card estrategias-card">
                    <h3><i class="fa fa-lightbulb-o" aria-hidden="true"/> Estrategias de hoy</h3>
                    <div class="estrategias-grupo" t-if="state.estrategias.empujar.length">
                        <div class="estrategias-titulo estrategias-empujar">Qué empujar</div>
                        <div t-foreach="state.estrategias.empujar" t-as="e" t-key="e.id" class="estrategia-item">
                            <b t-esc="e.titulo"/>
                            <div t-if="e.texto" class="estrategia-texto" t-esc="e.texto"/>
                            <div t-if="e.productos.length" class="estrategia-productos" t-esc="e.productos.map((p) => p.nombre).join(' · ')"/>
                        </div>
                    </div>
                    <div class="estrategias-grupo" t-if="state.estrategias.no_ofrecer.length">
                        <div class="estrategias-titulo estrategias-no-ofrecer">No ofrezcas</div>
                        <div t-foreach="state.estrategias.no_ofrecer" t-as="e" t-key="e.id" class="estrategia-item">
                            <b t-esc="e.titulo"/>
                            <div t-if="e.texto" class="estrategia-texto" t-esc="e.texto"/>
                            <div t-if="e.productos.length" class="estrategia-productos" t-esc="e.productos.map((p) => p.nombre).join(' · ')"/>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn btn-primary" t-on-click="toggleEstrategias">Entendido</button>
                    </div>
                </div>
            </div>

            <t t-set="prog" t-value="progresoVista"/>
            <div class="progreso-juego" t-if="prog" role="button" t-on-click="abrirJuego">
                <div class="progreso-juego-fila">
                    <b>Nivel <t t-esc="prog.nivel"/> · <t t-esc="prog.nivel_nombre"/></b>
                    <span><t t-esc="prog.xp_total"/> XP</span>
                </div>
                <div class="medidor-barra"><div class="medidor-relleno" t-att-style="'width:' + prog.avance + '%'"/></div>
                <div class="progreso-juego-mes">
                    Este mes: <t t-esc="prog.pedidos_mes"/> pedido(s) · $<t t-esc="Math.round(prog.ventas_mes).toLocaleString('en-US')"/> · <i class="fa fa-star" aria-hidden="true"/> <t t-esc="prog.estrellas_mes"/>
                </div>
                <div class="progreso-juego-link">
                    Logros, equipo y temporada ›
                    <span class="progreso-juego-nuevo" t-if="state.logrosNuevosHoy">¡<t t-esc="state.logrosNuevosHoy"/> logro(s) hoy!</span>
                </div>
            </div>

            <JuegoPanel t-if="state.juegoAbierto" onCerrar.bind="cerrarJuego" onRepasarTutorial.bind="repasarTutorial"/>
            <Tutorial
                t-if="state.tutorialAbierto"
                repaso="state.tutorialRepaso"
                nombre="state.tutorialNombre"
                onCerrar.bind="cerrarTutorial"
                onIrAlMapa.bind="irAlMapaDesdeTutorial"
            />

            <div class="search-row">
                <div class="search-box-live">
                    <span class="search-icon"><i class="fa fa-search" aria-hidden="true"/></span>
                    <input
                        type="text"
                        placeholder="Buscar ruta o cliente por nombre…"
                        t-model="state.busqueda"
                        autocomplete="off"
                    />
                </div>
            </div>

            <button class="sin-ventas-toggle" t-if="cantidadRutasSinVentas" t-on-click="toggleSinVentas">
                <i t-attf-class="fa {{state.verSinVentas ? 'fa-eye-slash' : 'fa-eye'}}" aria-hidden="true"/>
                <t t-if="state.verSinVentas">Ocultar rutas sin pendientes</t>
                <t t-else="">Mostrar <t t-esc="cantidadRutasSinVentas"/> ruta(s) sin pendientes</t>
            </button>

            <div class="segmented">
                <button
                    t-att-class="state.vista === 'mapa' ? 'active' : ''"
                    t-on-click="() => this.cambiarVista('mapa')"
                ><i class="fa fa-map-o" aria-hidden="true"/> Mapa</button>
                <button
                    t-att-class="state.vista === 'lista' ? 'active' : ''"
                    t-on-click="() => this.cambiarVista('lista')"
                ><i class="fa fa-list" aria-hidden="true"/> Lista</button>
            </div>

            <div class="busqueda-panel" t-if="buscando">
                <div class="busqueda-resumen">
                    <b t-if="!state.buscandoClientes" t-esc="resumenBusqueda"/>
                    <b t-else="">Buscando…</b>
                    <span class="busqueda-chips">
                        <button t-att-class="state.filtroBusqueda === 'todos' ? 'active' : ''" t-on-click="() => this.setFiltroBusqueda('todos')">Todos</button>
                        <button t-att-class="state.filtroBusqueda === 'clientes' ? 'active' : ''" t-on-click="() => this.setFiltroBusqueda('clientes')">Clientes <t t-esc="state.clientesEncontrados.length"/></button>
                        <button t-att-class="state.filtroBusqueda === 'rutas' ? 'active' : ''" t-on-click="() => this.setFiltroBusqueda('rutas')">Rutas <t t-esc="schedulesFiltrados.length"/></button>
                        <button class="busqueda-borrar" t-on-click="limpiarBusqueda" aria-label="Borrar búsqueda"><i class="fa fa-times" aria-hidden="true"/></button>
                    </span>
                </div>
                <t t-if="mostrarResultadosClientes">
                    <div class="busqueda-resultado" t-foreach="state.clientesEncontrados" t-as="r" t-key="r.location_id">
                        <t t-set="rs" t-value="resaltarTexto(r.name)"/>
                        <t t-set="est" t-value="estadoResultado(r)"/>
                        <div class="cliente-avatar" t-esc="(r.name || '?').slice(0, 2).toUpperCase()"/>
                        <div class="busqueda-info">
                            <div class="name"><t t-esc="rs.pre"/><mark t-if="rs.hit" t-esc="rs.hit"/><t t-esc="rs.post"/></div>
                            <div class="addr" t-esc="r.street"/>
                            <div class="busqueda-etiquetas">
                                <span class="route-tag" t-esc="r.route_name + (r.parada ? ' · parada ' + r.parada : '')"/>
                                <span t-attf-class="busqueda-estado busqueda-estado-{{est.tono}}" t-esc="est.texto"/>
                                <span class="route-tag route-tag-sin-asignar" t-if="quienAtiendeResultado(r)" t-esc="'La atiende ' + quienAtiendeResultado(r)"/>
                            </div>
                        </div>
                        <div class="busqueda-acciones">
                            <button class="quick-icon-btn" title="Llamar" t-on-click="() => this.llamarResultado(r)"><i class="fa fa-phone" aria-hidden="true"/></button>
                            <button class="busqueda-ir" t-on-click="() => this.irARutaDeResultado(r)">Ir a la ruta <i class="fa fa-chevron-right" aria-hidden="true"/></button>
                        </div>
                    </div>
                </t>
                <div class="busqueda-salida" t-if="!state.buscandoClientes">
                    <b t-if="!state.clientesEncontrados.length and !schedulesFiltrados.length">No encontramos «<t t-esc="textoBusqueda"/>» en rutas ni clientes.</b>
                    <b t-else="">¿No es ninguno de estos?</b>
                    <div class="busqueda-salida-botones">
                        <button class="busqueda-btn" t-on-click="buscarEnTodosLosClientes"><i class="fa fa-users" aria-hidden="true"/> Buscar en todos los clientes</button>
                        <button class="busqueda-btn busqueda-btn-fuerte" t-on-click="crearClienteDesdeBusqueda"><i class="fa fa-plus" aria-hidden="true"/> Crear cliente «<t t-esc="textoBusqueda"/>»</button>
                    </div>
                </div>
            </div>

            <div t-if="mostrarRutasEnBusqueda" t-attf-class="hub-cuerpo {{state.vista === 'lista' ? 'lista-sola' : ''}}">
            <div class="rutas-mapa-wrap" t-if="state.vista === 'mapa' and !state.cargando">
                <div class="rutas-mapa" t-ref="mapaRutas"/>
                <div class="mapa-leyenda">
                    <span class="mapa-leyenda-item"><i class="mapa-leyenda-punto mapa-leyenda-libre"/>Libre</span>
                    <span class="mapa-leyenda-item" t-foreach="leyendaTomas" t-as="t" t-key="t.person_id">
                        <i t-attf-class="mapa-leyenda-punto tc-{{t.color}}"/><t t-esc="t.nombre.split(' ')[0]"/>
                    </span>
                </div>
                <div class="rutas-mapa-nota" t-if="!rutasEnMapa.length">
                    Ninguna ruta de este filtro tiene clientes con GPS todavía: usa la lista.
                </div>
                <div class="rutas-mapa-nota" t-elif="rutasSinGps">
                    <t t-esc="rutasSinGps"/> ruta(s) no aparecen en el mapa porque sus clientes aún no tienen GPS.
                </div>
            </div>

            <div class="view" t-if="state.vista === 'lista' or (state.vista === 'mapa' and pantalla.ancha)">
                <div t-if="state.cargando" class="shalom-vacio">Cargando tus rutas…</div>
                <t t-elif="schedulesFiltrados.length === 0">
                    <div class="shalom-vacio" t-if="state.schedules.length === 0">
                        Todavía no tenés rutas programadas. Pedile a oficina que te
                        asignen una desde "Programación de Rutas".
                    </div>
                    <div class="shalom-vacio" t-else="">
                        Ninguna ruta coincide con la búsqueda.
                    </div>
                </t>
                <t t-else="">
                    <button
                        t-attf-class="route-card {{schedule.es_visita_express ? 'route-card-express' : ''}}"
                        t-foreach="schedulesFiltrados"
                        t-as="schedule"
                        t-key="schedule.id"
                        t-on-click="() => this.abrir(schedule)"
                    >
                        <div class="route-count" t-if="!schedule.es_visita_express">
                            <b t-esc="schedule.pendientes_con_ventas"/>
                            <span>por visitar</span>
                        </div>
                        <div class="route-main">
                        <div class="route-card-head">
                            <span class="rname">
                                <i t-if="schedule.es_visita_express" class="fa fa-bolt" aria-hidden="true"/>
                                <t t-esc="schedule.route_name"/>
                            </span>
                            <span
                                class="stop-badge"
                                t-attf-style="background: var(--shalom-{{claseEstado(schedule.estado)}}-soft); color: var(--shalom-{{claseEstado(schedule.estado)}});"
                                t-esc="etiquetaEstado(schedule.estado)"
                            />
                        </div>
                        <div class="route-card-stats">
                            <span t-if="schedule.esperado_mio"><i class="fa fa-line-chart" aria-hidden="true"/> Por vender <b t-esc="'~$' + Math.round(schedule.esperado_mio).toLocaleString('en-US')"/></span>
                            <span><i class="fa fa-users" aria-hidden="true"/> <b t-esc="schedule.cantidad_clientes"/> clientes</span>
                            <span><i class="fa fa-clock-o" aria-hidden="true"/> <b t-esc="formatoHoras(schedule.tiempo_estimado)"/> estimadas</span>
                            <span><i class="fa fa-money" aria-hidden="true"/> <b t-esc="'$' + schedule.capacidad.toFixed(2)"/> capacidad</span>
                        </div>
                        <div class="addr" t-esc="etiquetaRangoSchedule(schedule)"/>
                        <div class="quien-fila" t-if="schedule.tomada_por and schedule.tomada_por.length">
                            <span t-foreach="schedule.tomada_por" t-as="t" t-key="t.person_id" t-attf-class="quien-chip tc-{{t.color}}" t-esc="t.inicial"/>
                            <span class="quien-txt">
                                <t t-if="textoQuien(schedule)">La está atendiendo <t t-esc="textoQuien(schedule)"/></t>
                                <t t-else="">La estás atendiendo tú</t>
                            </span>
                        </div>
                        </div>
                        <i class="fa fa-chevron-right route-chevron" aria-hidden="true"/>
                    </button>
                </t>
            </div>
            </div>
        </div>
    </t>
</templates>
