<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.RutasHub">
        <div class="shalom-screen">
            <div class="topbar">
                <div class="topbar-row">
                    <div class="topbar-title">
                        <div class="route-name">Rutas</div>
                        <div class="route-sub"><span>Las que te asignaron</span></div>
                    </div>
                    <button class="estrategias-btn" t-if="totalEstrategias" t-on-click="toggleEstrategias">
                        <i class="fa fa-lightbulb-o" aria-hidden="true"/> Estrategias
                    </button>
                    <TemaSelector/>
                </div>
            </div>

            <button class="avisos-btn" title="Avisos por WhatsApp" aria-label="Avisos por WhatsApp" t-if="state.avisosPendientes !== null" t-on-click="abrirAvisos">
                <i class="fa fa-whatsapp" aria-hidden="true"/>
                <span class="avisos-btn-txt">Avisos</span>
                <span class="avisos-btn-cuenta" t-if="state.avisosPendientes" t-esc="state.avisosPendientes"/>
            </button>
            <Avisos t-if="state.avisosAbiertos" onCerrar.bind="cerrarAvisos"/>

            <div class="confirm-overlay" t-if="state.estrategiasAbiertas" t-on-click.self="toggleEstrategias">
                <div class="confirm-card estrategias-card">
                    <h3><i class="fa fa-lightbulb-o" aria-hidden="true"/> Estrategias de hoy</h3>
                    <div class="estrategias-grupo" t-if="state.estrategias.empujar.length">
                        <div class="estrategias-titulo estrategias-empujar">Qué empujar</div>
                        <div t-foreach="state.estrategias.empujar" t-as="e" t-key="e.id" class="estrategia-item">
                            <b t-esc="e.titulo"/>
                            <div t-if="e.texto" class="estrategia-texto" t-esc="e.texto"/>
                            <div t-if="e.productos.length" class="estrategia-productos" t-esc="e.productos.map((p) => p.nombre).join(' · ')"/>
                        </div>
                    </div>
                    <div class="estrategias-grupo" t-if="state.estrategias.no_ofrecer.length">
                        <div class="estrategias-titulo estrategias-no-ofrecer">No ofrezcas</div>
                        <div t-foreach="state.estrategias.no_ofrecer" t-as="e" t-key="e.id" class="estrategia-item">
                            <b t-esc="e.titulo"/>
                            <div t-if="e.texto" class="estrategia-texto" t-esc="e.texto"/>
                            <div t-if="e.productos.length" class="estrategia-productos" t-esc="e.productos.map((p) => p.nombre).join(' · ')"/>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn btn-primary" t-on-click="toggleEstrategias">Entendido</button>
                    </div>
                </div>
            </div>

            <t t-set="prog" t-value="progresoVista"/>
            <div class="progreso-juego" t-if="prog" role="button" t-on-click="abrirJuego">
                <div class="progreso-juego-fila">
                    <b>Nivel <t t-esc="prog.nivel"/> · <t t-esc="prog.nivel_nombre"/></b>
                    <span><t t-esc="prog.xp_total"/> XP</span>
                </div>
                <div class="medidor-barra"><div class="medidor-relleno" t-att-style="'width:' + prog.avance + '%'"/></div>
                <div class="progreso-juego-mes">
                    Este mes: <t t-esc="prog.pedidos_mes"/> pedido(s) · $<t t-esc="Math.round(prog.ventas_mes).toLocaleString('en-US')"/> · ★ <t t-esc="prog.estrellas_mes"/>
                </div>
                <div class="progreso-juego-link">
                    Logros, equipo y temporada ›
                    <span class="progreso-juego-nuevo" t-if="state.logrosNuevosHoy">¡<t t-esc="state.logrosNuevosHoy"/> logro(s) hoy!</span>
                </div>
            </div>

            <JuegoPanel t-if="state.juegoAbierto" onCerrar.bind="cerrarJuego" onRepasarTutorial.bind="repasarTutorial"/>
            <Tutorial
                t-if="state.tutorialAbierto"
                repaso="state.tutorialRepaso"
                nombre="state.tutorialNombre"
                onCerrar.bind="cerrarTutorial"
                onIrAlMapa.bind="irAlMapaDesdeTutorial"
            />

            <div class="search-row">
                <div class="search-box-live">
                    <span class="search-icon"><i class="fa fa-search" aria-hidden="true"/></span>
                    <input
                        type="text"
                        placeholder="Buscar ruta por nombre…"
                        t-model="state.busqueda"
                        autocomplete="off"
                    />
                </div>
                <div class="groupby-row">
                    <button class="groupby-btn" t-on-click="toggleMenuPeriodo">
                        <span><i class="fa fa-calendar-o" aria-hidden="true"/> <b t-esc="etiquetaPeriodo(state.periodo)"/></span>
                        <span class="chev">▾</span>
                    </button>
                    <div class="groupby-menu" t-if="state.menuPeriodoAbierto">
                        <button
                            t-att-class="state.periodo === 'todos' ? 'active' : ''"
                            t-on-click="() => this.elegirPeriodo('todos')"
                        >Todo el periodo</button>
                        <t t-foreach="semanas" t-as="semana" t-key="semana.date_start">
                            <button
                                t-att-class="state.periodo === semana.date_start ? 'active' : ''"
                                t-on-click="() => this.elegirPeriodo(semana.date_start)"
                                t-esc="etiquetaPeriodo(semana.date_start)"
                            />
                        </t>
                    </div>
                </div>
            </div>

            <div class="segmented">
                <button
                    t-att-class="state.vista === 'mapa' ? 'active' : ''"
                    t-on-click="() => this.cambiarVista('mapa')"
                ><i class="fa fa-map-o" aria-hidden="true"/> Mapa</button>
                <button
                    t-att-class="state.vista === 'lista' ? 'active' : ''"
                    t-on-click="() => this.cambiarVista('lista')"
                >☰ Lista</button>
            </div>

            <div class="rutas-mapa-wrap" t-if="state.vista === 'mapa' and !state.cargando">
                <div class="rutas-mapa" t-ref="mapaRutas"/>
                <div class="rutas-mapa-nota" t-if="!rutasEnMapa.length">
                    Ninguna ruta de este filtro tiene clientes con GPS todavía: usa la lista.
                </div>
                <div class="rutas-mapa-nota" t-elif="rutasSinGps">
                    <t t-esc="rutasSinGps"/> ruta(s) no aparecen en el mapa porque sus clientes aún no tienen GPS.
                </div>
            </div>

            <div class="view" t-if="state.vista === 'lista'">
                <div t-if="state.cargando" class="shalom-vacio">Cargando tus rutas…</div>
                <t t-elif="schedulesFiltrados.length === 0">
                    <div class="shalom-vacio" t-if="state.schedules.length === 0">
                        Todavía no tenés rutas programadas. Pedile a oficina que te
                        asignen una desde "Programación de Rutas".
                    </div>
                    <div class="shalom-vacio" t-else="">
                        Ninguna ruta coincide con la búsqueda.
                    </div>
                </t>
                <t t-else="">
                    <button
                        t-attf-class="route-card {{schedule.es_visita_express ? 'route-card-express' : ''}}"
                        t-foreach="schedulesFiltrados"
                        t-as="schedule"
                        t-key="schedule.id"
                        t-on-click="() => this.abrir(schedule)"
                    >
                        <div class="route-card-head">
                            <span class="rname">
                                <i t-if="schedule.es_visita_express" class="fa fa-bolt" aria-hidden="true"/>
                                <t t-esc="schedule.route_name"/>
                            </span>
                            <span
                                class="stop-badge"
                                t-attf-style="background: var(--shalom-{{claseEstado(schedule.estado)}}-soft); color: var(--shalom-{{claseEstado(schedule.estado)}});"
                                t-esc="etiquetaEstado(schedule.estado)"
                            />
                        </div>
                        <div class="route-card-stats">
                            <span>👥 <b t-esc="schedule.cantidad_clientes"/> clientes</span>
                            <span>⏱ <b t-esc="formatoHoras(schedule.tiempo_estimado)"/> estimadas</span>
                            <span>💵 <b t-esc="'$' + schedule.capacidad.toFixed(2)"/> capacidad</span>
                        </div>
                        <div class="addr" t-esc="etiquetaRangoSchedule(schedule)"/>
                    </button>
                </t>
            </div>
        </div>
    </t>
</templates>
