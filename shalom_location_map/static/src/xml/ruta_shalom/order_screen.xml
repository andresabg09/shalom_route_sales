<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.OrderScreen">
        <div class="order-overlay" t-att-class="state.cerrando ? 'closing' : ''">
            <div class="order-topbar">
                <button class="icon-btn" t-on-click="atras" title="Atrás">←</button>
                <div class="order-topbar-title">
                    <div class="route-name" t-esc="state.pantalla === 'carrito' ? 'Carrito' : 'Tomar pedido'"/>
                    <div class="route-sub" t-esc="props.clienteNombre"/>
                </div>
                <TemaSelector/>
            </div>

            <div
                class="nag-banner"
                t-if="!state.cargando and state.datosFaltantes.length and !state.avisoDatosFaltantesCerrado"
            >
                <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                <div class="nag-banner-body">
                    <b><t t-esc="'A este cliente le faltan datos: ' + state.datosFaltantes.join(', ') + '.'"/></b>
                    Podés seguir armando el pedido igual.
                    <div class="nag-banner-actions">
                        <button class="nag-btn nag-btn-primary" t-on-click="abrirEdicionCliente">Completar ahora</button>
                        <button class="nag-btn" t-on-click="cerrarAvisoDatosFaltantes">Ahora no</button>
                    </div>
                </div>
                <button class="nag-banner-close" t-on-click="cerrarAvisoDatosFaltantes" title="Cerrar">✕</button>
            </div>

            <t t-set="med" t-value="medidor"/>
            <div class="medidor" t-if="med and !state.cargando">
                <div class="medidor-fila">
                    <b class="medidor-total" t-esc="'$' + total.toFixed(2)"/>
                    <span class="medidor-estrellas" t-if="med.tiene" t-att-title="med.estrellas + ' de 3 estrellas'">
                        <span t-foreach="[1, 2, 3]" t-as="n" t-key="n" t-att-class="med.estrellas >= n ? 'estrella-on estrella-' + n : 'estrella-off'">★</span>
                    </span>
                    <span class="medidor-margen" t-if="med.verMargen" t-att-class="med.margenBajo ? 'margen-bajo' : 'margen-ok'" t-esc="'Margen ' + Math.round(med.margen) + '%'"/>
                </div>
                <div class="medidor-barra" t-if="med.tiene">
                    <div class="medidor-relleno" t-att-style="'width:' + med.relleno + '%'"/>
                    <span
                        t-foreach="med.marcas" t-as="marca" t-key="marca.clase"
                        class="medidor-marca" t-att-class="'marca-' + marca.clase"
                        t-att-style="'left:' + marca.pos + '%'"
                    />
                </div>
                <div class="medidor-leyenda" t-if="med.tiene">
                    <span t-foreach="med.marcas" t-as="marca" t-key="marca.clase" t-att-class="'leyenda-' + marca.clase">
                        <t t-esc="marca.clase === 'bronce' ? '★ ' : (marca.clase === 'plata' ? '★★ ' : '★★★ ')"/><t t-esc="marca.texto"/>
                    </span>
                </div>
                <div class="medidor-mensaje" t-att-class="'tono-' + med.tono" t-esc="med.mensaje"/>
            </div>

            <div t-if="state.cargando" class="shalom-vacio">Cargando catálogo…</div>

            <t t-elif="state.pantalla === 'catalogo'">
                <div class="search-row">
                    <div class="search-box-live">
                        <span><i class="fa fa-search" aria-hidden="true"/></span>
                        <input
                            type="text"
                            placeholder="Buscar producto, código o barcode…"
                            t-model="state.busqueda"
                            t-on-input="onBusquedaInput"
                        />
                    </div>
                    <button class="icon-btn" t-on-click="iniciarEscaneo" title="Escanear código de barras"><i class="fa fa-camera" aria-hidden="true"/></button>
                </div>

                <button class="precarga-btn" t-on-click="abrirPrecarga">
                    <span>
                        <b>Precargar de pedidos anteriores</b>
                        <small>Un pedido completo o productos sueltos</small>
                    </span>
                    <i class="fa fa-angle-right" aria-hidden="true"/>
                </button>

                <div class="categ-bar">
                    <div class="categ-selector-wrap">
                        <button class="categ-selector-btn" t-on-click="toggleCategMenu">
                            <span t-esc="etiquetaCategoriaActual"/>
                            <span class="chev">▾</span>
                        </button>
                        <div class="categ-menu" t-if="state.categMenuAbierto">
                            <input
                                type="text"
                                class="categ-menu-search"
                                placeholder="Buscar categoría…"
                                t-model="state.busquedaCategoria"
                            />
                            <div class="categ-menu-list">
                                <button
                                    t-att-class="state.categoriaSeleccionada === 'todas' ? 'categ-menu-item active' : 'categ-menu-item'"
                                    t-on-click="() => this.elegirCategoria('todas')"
                                >Todas las categorías</button>
                                <button
                                    t-foreach="categoriasFiltradas"
                                    t-as="categoria"
                                    t-key="categoria.id"
                                    t-att-class="state.categoriaSeleccionada === categoria.id ? 'categ-menu-item active' : 'categ-menu-item'"
                                    t-on-click="() => this.elegirCategoria(categoria.id)"
                                ><t t-esc="categoria.nombre"/></button>
                                <div t-if="!categoriasFiltradas.length" class="shalom-vacio">Sin resultados.</div>
                            </div>
                        </div>
                    </div>
                    <button
                        class="stock-toggle-btn"
                        t-att-class="state.soloConStock ? 'active' : ''"
                        t-on-click="toggleSoloConStock"
                    >Con stock</button>
                </div>

                <div class="view catalog-list">
                    <div class="paginador" t-if="totalPaginas > 1">
                        <button class="btn btn-ghost" t-on-click="paginaAnterior" t-att-disabled="state.paginaActual === 1">‹ Anterior</button>
                        <span class="paginador-info" t-esc="'Página ' + state.paginaActual + ' de ' + totalPaginas"/>
                        <button class="btn btn-ghost" t-on-click="paginaSiguiente" t-att-disabled="state.paginaActual === totalPaginas">Siguiente ›</button>
                    </div>

                    <div t-if="!productosFiltrados.length" class="shalom-vacio">
                        No se encontraron productos.
                    </div>
                    <div
                        t-foreach="productosPaginados"
                        t-as="producto"
                        t-key="producto.id"
                        class="product-card"
                        t-att-class="cantidadEnCarrito(producto.id) ? 'product-card-en-carrito' : ''"
                    >
                        <div class="name" t-esc="producto.name"/>
                        <div class="product-thumb-wrap">
                            <img class="product-thumb" t-att-src="imagenUrl(producto)" alt="" t-on-error="onImagenError"/>
                        </div>
                        <div class="product-side">
                            <!-- Marca de estrategia en la columna lateral (dentro del
                                 nombre, que se recorta a 2 líneas, quedaba cortada). -->
                            <span t-if="estrategiaDe(producto) === 'no_ofrecer'" class="estrategia-marca marca-no-ofrecer">NO OFRECER</span>
                            <span t-elif="estrategiaDe(producto) === 'empujar'" class="estrategia-marca marca-empujar">EMPUJAR</span>
                            <div class="price-label">Precio unitario</div>
                            <div class="price" t-esc="'$' + producto.list_price.toFixed(2)"/>
                            <t t-set="bodegas" t-value="chipsBodegas(producto)"/>
                            <t t-if="bodegas">
                                <div class="stock-chips">
                                    <span class="stock-badge" t-att-class="'tono-' + bodegas.dianke.tono" t-esc="bodegas.dianke.texto"/>
                                    <span class="stock-badge" t-att-class="'tono-' + bodegas.nevada.tono" t-esc="bodegas.nevada.texto"/>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-set="existencia" t-value="infoExistencia(producto)"/>
                                <span class="stock-badge" t-att-class="'tono-' + existencia.tono" t-esc="existencia.texto"/>
                            </t>
                            <div class="reservados" t-if="reservados(producto)" t-esc="reservados(producto) + ' reservados'"/>
                        </div>
                        <t t-if="cantidadEnCarrito(producto.id) and etiquetaPromo(producto.id)">
                            <div
                                class="promo-badge"
                                t-att-class="promoCompleta(producto.id) ? 'promo-completa' : 'promo-pendiente'"
                                t-esc="etiquetaPromo(producto.id)"
                            />
                        </t>
                        <button
                            t-if="!cantidadEnCarrito(producto.id)"
                            class="qty-add-btn"
                            t-on-click="() => this.agregarProducto(producto)"
                        >+ Agregar</button>
                        <div t-else="" class="qty-row">
                            <div class="qty-stepper">
                                <button t-on-click="() => this.cambiarCantidad(producto.id, -1)">−</button>
                                <input
                                    type="number"
                                    min="1"
                                    class="qty-input"
                                    t-att-value="cantidadEnCarrito(producto.id)"
                                    t-on-change="(ev) => this.cambiarCantidadManual(producto.id, ev)"
                                    t-on-focus="seleccionarTextoCantidad"
                                />
                                <button t-on-click="() => this.cambiarCantidad(producto.id, 1)">+</button>
                            </div>
                            <button
                                class="qty-trash-btn"
                                title="Quitar del carrito"
                                t-on-click="() => this.quitarDelCarrito(producto.id)"
                            ><i class="fa fa-trash-o" aria-hidden="true"/></button>
                        </div>
                    </div>

                    <div class="paginador" t-if="totalPaginas > 1">
                        <button class="btn btn-ghost" t-on-click="paginaAnterior" t-att-disabled="state.paginaActual === 1">‹ Anterior</button>
                        <span class="paginador-info" t-esc="'Página ' + state.paginaActual + ' de ' + totalPaginas"/>
                        <button class="btn btn-ghost" t-on-click="paginaSiguiente" t-att-disabled="state.paginaActual === totalPaginas">Siguiente ›</button>
                    </div>
                </div>

                <div class="cart-footer" t-if="cantidadItems" t-on-click="irACarrito">
                    <span class="cart-footer-count" t-esc="cantidadItems + ' producto(s)'"/>
                    <span class="cart-footer-total" t-esc="'$' + total.toFixed(2)"/>
                    <span class="cart-footer-arrow">Ver carrito ▸</span>
                </div>
            </t>

            <t t-elif="state.pantalla === 'carrito'">
                <div class="view cart-list">
                    <div t-if="!itemsCarrito.length" class="shalom-vacio">El carrito está vacío.</div>
                    <div t-foreach="itemsCarrito" t-as="item" t-key="item.esRecompensa ? 'reward-' + item.reglaId : item.producto.id" class="cart-line">
                        <div class="product-thumb-wrap">
                            <img
                                t-if="!item.esRecompensa"
                                class="product-thumb"
                                t-att-src="imagenUrl(item.producto)"
                                alt=""
                                t-on-error="onImagenError"
                            />
                            <span t-else="" class="reward-icon"><i class="fa fa-gift" aria-hidden="true"/></span>
                        </div>
                        <div class="product-info">
                            <div class="name" t-esc="(item.esRecompensa ? 'Promoción: ' : '') + item.producto.name"/>
                            <t t-if="item.esRecompensa">
                                <div class="addr">
                                    <span class="promo-badge promo-completa"><i class="fa fa-gift" aria-hidden="true"/> Promoción — producto gratis</span>
                                </div>
                                <div class="cart-line-bottom-row">
                                    <div class="cart-line-subtotal" t-esc="'x' + item.cantidad"/>
                                    <button class="qty-trash-btn" t-on-click="() => this.quitarDelCarrito('reward-' + item.reglaId)">
                                        <i class="fa fa-trash-o" aria-hidden="true"/> Eliminar
                                    </button>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="addr" t-esc="'$' + item.producto.list_price.toFixed(2) + ' c/u'"/>
                                <div class="qty-row">
                                    <div class="qty-stepper">
                                        <button t-on-click="() => this.cambiarCantidad(item.producto.id, -1)">−</button>
                                        <input
                                            type="number"
                                            min="1"
                                            class="qty-input"
                                            t-att-value="item.cantidad"
                                            t-on-change="(ev) => this.cambiarCantidadManual(item.producto.id, ev)"
                                            t-on-focus="seleccionarTextoCantidad"
                                        />
                                        <button t-on-click="() => this.cambiarCantidad(item.producto.id, 1)">+</button>
                                    </div>
                                </div>
                                <span
                                    t-if="etiquetaPromo(item.producto.id)"
                                    class="promo-badge"
                                    t-att-class="promoCompleta(item.producto.id) ? 'promo-completa' : 'promo-pendiente'"
                                    t-esc="etiquetaPromo(item.producto.id)"
                                />
                                <div class="cart-line-bottom-row">
                                    <div class="cart-line-subtotal" t-esc="'$' + (item.cantidad * item.producto.list_price).toFixed(2)"/>
                                    <button class="qty-trash-btn" t-on-click="() => this.quitarDelCarrito(item.producto.id)">
                                        <i class="fa fa-trash-o" aria-hidden="true"/> Eliminar
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <button class="reward-cta" t-if="recompensasConDisponibilidad.length" t-on-click="abrirRecompensas">
                    <i class="fa fa-gift" aria-hidden="true"/> Recompensa disponible
                </button>

                <div class="cart-total-row">
                    <span>Total</span>
                    <span t-esc="'$' + total.toFixed(2)"/>
                </div>
                <button
                    class="cart-review-btn"
                    t-on-click="revisarCotizacion"
                    t-att-disabled="state.guardandoBorrador || state.confirmando || !itemsCarrito.length"
                >
                    <t t-if="state.guardandoBorrador">Guardando…</t>
                    <t t-else=""><i class="fa fa-file-text-o" aria-hidden="true"/> Revisar cotización (precios/promos en Ventas)</t>
                </button>
                <button
                    class="cta-order"
                    t-on-click="confirmarPedido"
                    t-att-disabled="state.confirmando || state.guardandoBorrador || !itemsCarrito.length"
                >
                    <t t-if="state.confirmando">Finalizando…</t>
                    <t t-else="">Finalizar a orden de venta</t>
                </button>
            </t>

            <div class="scan-overlay" t-if="state.escaneando">
                <video t-ref="video" class="scan-video" autoplay="autoplay" playsinline="playsinline" muted="muted"/>
                <div class="scan-frame"/>
                <div class="scan-hint">Apuntá al código de barras del producto</div>
                <button class="btn btn-ghost scan-cancel" t-on-click="detenerEscaneo">Cancelar</button>
            </div>

            <div class="confirm-overlay" t-if="state.confirmandoSalida">
                <div class="confirm-card">
                    <h3>¿Salir sin guardar?</h3>
                    <p>
                        Tenés <t t-esc="cantidadItems"/> producto(s) en el carrito que
                        todavía no se guardaron como cotización. Si salís ahora, se
                        pierden.
                    </p>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cancelarSalir">Seguir armando</button>
                        <button class="btn btn-primary" t-on-click="confirmarSalirSinGuardar">Salir y perder el carrito</button>
                    </div>
                </div>
            </div>

            <div class="confirm-overlay" t-if="state.mostrandoAvisoConfirmar">
                <div class="confirm-card">
                    <h3><i class="fa fa-exclamation-triangle" aria-hidden="true"/> Antes de <t t-esc="state.accionPendienteAvisoDatos === 'revisar' ? 'revisar' : 'confirmar'"/>…</h3>
                    <p>
                        A "<t t-esc="props.clienteNombre"/>" todavía le falta:
                        <t t-esc="state.datosFaltantes.join(', ')"/>. La cotización se
                        puede <t t-esc="state.accionPendienteAvisoDatos === 'revisar' ? 'guardar' : 'confirmar'"/>
                        igual, pero después va a tocar completarlo desde oficina.
                    </p>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cerrarAvisoConfirmar">Volver</button>
                        <button class="btn btn-secondary" t-on-click="abrirEdicionCliente">Completar datos del cliente</button>
                        <button class="btn btn-primary" t-on-click="continuarIgnorandoAvisoDatos">
                            <t t-esc="state.accionPendienteAvisoDatos === 'revisar' ? 'Revisar cotización de todas formas' : 'Confirmar cotización de todas formas'"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Pop-up OBLIGATORIO de Forma de Pago + Fecha especial de
                 entrega, SOLO al confirmar un pedido (nunca al revisar
                 cotización): ver el punto 11 del docstring grande de
                 fsm_order.py y _abrirPopupFormaPago() en
                 order_screen.js. A diferencia del interstitial de
                 arriba (condicional), este siempre aparece antes de
                 _confirmarPedidoDeVerdad(), sin excepción. -->
            <div class="confirm-overlay" t-if="state.mostrandoFormaPago">
                <div class="confirm-card">
                    <h3><i class="fa fa-credit-card" aria-hidden="true"/> Forma de pago</h3>
                    <p>Antes de confirmar, indicá cómo va a pagar "<t t-esc="props.clienteNombre"/>".</p>
                    <div t-if="state.cargandoFormaPago" class="edit-field">Cargando…</div>
                    <t t-else="">
                        <div class="edit-field">
                            <label>Forma de pago</label>
                            <select t-model="state.formaPagoSeleccionada">
                                <option
                                    t-foreach="state.formasPagoDisponibles"
                                    t-as="opcion"
                                    t-key="opcion.value"
                                    t-att-value="opcion.value"
                                ><t t-esc="opcion.label"/></option>
                            </select>
                        </div>
                        <!-- Mismo widget nativo de calendario que ya usa
                             admin_gestion.js para Visita Exprés (DateTimeInput),
                             no un <input type="date"> a mano: pedido explícito,
                             para que sea el mismo selector que el resto de Odoo
                             (calendario con hoy resaltado, sin escribir día/mes/
                             año a mano) y que el popover se reposicione solo en
                             celular. -->
                        <div class="edit-field edit-field-fecha">
                            <label>Fecha especial de entrega (opcional)</label>
                            <DateTimeInput
                                type="'date'"
                                value="state.fechaEntregaEspecial"
                                onChange.bind="onCambiarFechaEntregaEspecial"
                            />
                        </div>
                        <!-- Puramente informativo (custom_itbms_required, ver
                             shalom_confirmar_pedido en fsm_order.py): no
                             toca ningún cálculo de impuestos de esta orden,
                             es para que Dianke (el proveedor que entrega la
                             mercadería, no Shalom) sepa si cobrar ITBMS. -->
                        <div class="edit-field">
                            <label>Incluye ITBMS</label>
                            <select t-on-change="onCambiarIncluyeItbms">
                                <option value="true" t-att-selected="state.incluyeItbms">Sí</option>
                                <option value="false" t-att-selected="!state.incluyeItbms">No</option>
                            </select>
                        </div>
                    </t>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cancelarFormaPago">Cancelar</button>
                        <button
                            class="btn btn-primary"
                            t-att-disabled="state.cargandoFormaPago"
                            t-on-click="confirmarFormaPago"
                        >Confirmar pedido</button>
                    </div>
                </div>
            </div>

            <div class="confirm-overlay" t-if="state.precargaAbierta">
                <div class="confirm-card precarga-card">
                    <h3>Precargar de pedidos anteriores</h3>
                    <p>Se suma al carrito lo que elijas; nada se bloquea por existencia.</p>
                    <div t-if="state.cargandoPrecarga" class="shalom-vacio">Cargando…</div>
                    <div t-elif="!state.pedidosAnteriores.length" class="shalom-vacio">Este cliente no tiene pedidos anteriores.</div>
                    <div t-else="" class="precarga-lista">
                        <div t-foreach="state.pedidosAnteriores" t-as="pedido" t-key="pedido.id" class="precarga-pedido">
                            <div class="precarga-pedido-cab" t-on-click="() => this.togglePedidoPrecarga(pedido.id)">
                                <div class="precarga-pedido-info">
                                    <div class="reward-option-nombre" t-esc="(pedido.fecha || '') + ' · ' + pedido.nombre"/>
                                    <div class="reward-option-detalle" t-esc="pedido.lineas.length + ' producto(s) · $' + pedido.total.toFixed(2)"/>
                                </div>
                                <button class="btn btn-primary precarga-todo-btn" t-on-click.stop="() => this.precargarPedido(pedido)">Agregar todo</button>
                            </div>
                            <div t-if="state.pedidoPrecargaAbierto === pedido.id" class="precarga-lineas">
                                <div t-foreach="pedido.lineas" t-as="linea" t-key="linea_index" class="precarga-linea">
                                    <t t-set="prodLinea" t-value="productoDeLinea(linea)"/>
                                    <div class="precarga-linea-nombre">
                                        <span t-esc="linea.nombre"/>
                                        <t t-if="prodLinea">
                                            <t t-set="chipsLinea" t-value="chipsBodegas(prodLinea)"/>
                                            <div class="stock-chips" t-if="chipsLinea">
                                                <span class="stock-badge" t-att-class="'tono-' + chipsLinea.dianke.tono" t-esc="chipsLinea.dianke.texto"/>
                                                <span class="stock-badge" t-att-class="'tono-' + chipsLinea.nevada.tono" t-esc="chipsLinea.nevada.texto"/>
                                            </div>
                                        </t>
                                    </div>
                                    <button class="btn btn-secondary precarga-linea-btn" t-on-click="() => this.precargarLinea(linea)">
                                        <t t-esc="'+ ' + linea.cantidad"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cerrarPrecarga">Cerrar</button>
                    </div>
                </div>
            </div>

            <t t-set="res" t-value="resultadoVista"/>
            <div class="resultado-overlay" t-if="res">
                <div class="resultado-card">
                    <div class="resultado-eyebrow">Pedido confirmado</div>
                    <div class="resultado-cliente" t-esc="props.clienteNombre"/>
                    <div class="resultado-estrellas">
                        <span t-foreach="[1, 2, 3]" t-as="n" t-key="n" t-att-class="res.estrellas >= n ? 'estrella-on estrella-' + n : 'estrella-off'">★</span>
                    </div>
                    <div class="resultado-estrellas-nombre" t-esc="res.etiquetaEstrellas"/>
                    <div class="resultado-linea">
                        <span>Total</span><b t-esc="'$' + res.total.toFixed(2)"/>
                    </div>
                    <div class="resultado-linea" t-if="res.pctDelTipico !== null">
                        <span>De su pedido típico</span><b t-esc="res.pctDelTipico + '%'"/>
                    </div>
                    <div class="resultado-linea" t-if="res.margen_pct !== undefined">
                        <span>Margen</span><b t-esc="Math.round(res.margen_pct) + '%'"/>
                    </div>
                    <div class="resultado-aviso resultado-record" t-if="res.record_roto and !res.margen_bajo">
                        ¡Récord roto! Es lo más que ha comprado este cliente.
                    </div>
                    <div class="resultado-aviso resultado-margen" t-if="res.margen_bajo">
                        Superaste su récord, pero el margen quedó bajo 20%: el oro no cuenta.
                    </div>
                    <div class="resultado-xp">
                        <b t-esc="'+' + res.xp + ' XP'"/>
                    </div>
                    <div class="resultado-nivel">
                        <div class="resultado-aviso resultado-record" t-if="res.subio_nivel">
                            ¡Subiste de nivel!
                        </div>
                        <div class="resultado-nivel-nombre">
                            Nivel <t t-esc="res.progreso.nivel"/> · <t t-esc="res.progreso.nivel_nombre"/>
                        </div>
                        <div class="medidor-barra">
                            <div class="medidor-relleno" t-att-style="'width:' + res.avance + '%'"/>
                        </div>
                        <div class="resultado-nivel-detalle" t-if="res.progreso.xp_siguiente">
                            <t t-esc="res.progreso.xp_total"/> XP · faltan <t t-esc="res.faltanXp"/> para el siguiente nivel
                        </div>
                        <div class="resultado-nivel-detalle" t-else="">
                            <t t-esc="res.progreso.xp_total"/> XP · nivel máximo
                        </div>
                    </div>
                    <button class="cta-order" t-on-click="cerrarResultadoJuego">Siguiente cliente</button>
                </div>
            </div>

            <div class="confirm-overlay" t-if="state.recompensaMenuAbierto">
                <div class="confirm-card">
                    <h3>Elegí la recompensa</h3>
                    <p>Hay promos completas de más de una referencia. Elegí cuál agregar primero -- se suman todas las unidades disponibles de esa referencia de una vez.</p>
                    <div class="reward-list">
                        <button
                            t-foreach="recompensasConDisponibilidad"
                            t-as="recompensa"
                            t-key="recompensa.regla_id"
                            class="reward-option"
                            t-on-click="() => this.elegirRecompensa(recompensa)"
                        >
                            <div class="reward-option-nombre" t-esc="'Promoción: ' + recompensa.reward_product_name"/>
                            <div class="reward-option-detalle" t-esc="recompensa.programa_nombre + ' · ' + (recompensa.restantes * recompensa.reward_qty) + ' unidad(es) disponibles'"/>
                        </button>
                    </div>
                    <div class="edit-actions">
                        <button class="btn btn-ghost" t-on-click="cerrarMenuRecompensas">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <ClienteForm
            t-if="state.editandoCliente and state.locationId"
            modo="'editar'"
            locationId="state.locationId"
            onGuardado.bind="clienteEditado"
            onCancelar.bind="cerrarEdicionCliente"
        />
    </t>
</templates>
