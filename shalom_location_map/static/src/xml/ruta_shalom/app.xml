<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shalom_location_map.RutaShalomApp">
        <div class="o_shalom_ruta_app">
            <div class="shalom-body">
                <RutasHub t-if="state.screen === 'rutas'" onAbrirRuta.bind="abrirRuta"/>
                <RutaDetalle
                    t-if="state.screen === 'ruta-detalle'"
                    schedule="state.scheduleActivo"
                    onVolver.bind="volverARutas"
                />
                <div class="shalom-screen" t-if="state.screen === 'cotizaciones'">
                    <div class="topbar">
                        <div class="route-name">Mis cotizaciones</div>
                    </div>
                    <div class="shalom-vacio">Disponible próximamente.</div>
                </div>
                <div class="shalom-screen" t-if="state.screen === 'clientes'">
                    <div class="topbar">
                        <div class="route-name">Clientes</div>
                    </div>
                    <div class="shalom-vacio">Disponible próximamente.</div>
                </div>
            </div>

            <div class="bottomnav">
                <button
                    t-att-class="(state.screen === 'rutas' || state.screen === 'ruta-detalle') ? 'active' : ''"
                    t-on-click="() => this.irA('rutas')"
                ><span>🗂️</span>Rutas</button>
                <button
                    t-att-class="state.screen === 'cotizaciones' ? 'active' : ''"
                    t-on-click="() => this.irA('cotizaciones')"
                ><span>🧾</span>Cotizaciones</button>
                <button
                    t-att-class="state.screen === 'clientes' ? 'active' : ''"
                    t-on-click="() => this.irA('clientes')"
                ><span>👤</span>Clientes</button>
            </div>
        </div>
    </t>
</templates>
